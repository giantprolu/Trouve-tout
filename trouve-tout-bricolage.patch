From c2046ab9caf2046f10b9613132ff6b46f348668c Mon Sep 17 00:00:00 2001
From: giantprolu <nathnathchav@gmail.com>
Date: Mon, 27 Jul 2026 21:41:49 +0000
Subject: [PATCH 1/2] fix(seo): corriger le domaine canonique et prerendre les
 pages statiques

Le site declarait https://trouve-tout.fr comme URL canonique sur chaque
page alors que le domaine reel est www.trouve-tout-conseil.fr. Google
suivait donc la canonique vers un domaine inexistant et n'indexait
aucune page.

- src/lib/site.ts : source unique de verite pour l'URL du site
- astro.config.mjs : ajout de 'site' (base des canonical / sitemap)
- Layout.astro : canonical, og:url, og:image et JSON-LD sur le bon domaine
  + normalisation du chemin (pas de slash final ni de query string)
- sitemap.xml.ts : les 86 <loc> pointent enfin sur le bon domaine
- robots.txt : directive Sitemap corrigee
- public/og-default.png : ajout de l'image OG (elle renvoyait 404)
- prerender + getStaticPaths sur les 95 pages statiques : HTML servi
  depuis le CDN au lieu d'une fonction serverless a chaque crawl
---
 astro.config.mjs                  |   3 +++
 public/og-default.png             | Bin 0 -> 25470 bytes
 public/robots.txt                 |   2 +-
 src/layouts/Layout.astro          |  10 ++++++++--
 src/lib/site.ts                   |  15 +++++++++++++++
 src/pages/blog/[slug].astro       |   6 ++++++
 src/pages/blog/index.astro        |   2 ++
 src/pages/categories/[slug].astro |   7 +++++++
 src/pages/categories/index.astro  |   2 ++
 src/pages/index.astro             |   2 ++
 src/pages/marques/[slug].astro    |   7 +++++++
 src/pages/marques/index.astro     |   2 ++
 src/pages/produits/[slug].astro   |   7 +++++++
 src/pages/produits/index.astro    |   2 ++
 src/pages/sitemap.xml.ts          |   5 ++++-
 15 files changed, 68 insertions(+), 4 deletions(-)
 create mode 100644 public/og-default.png
 create mode 100644 src/lib/site.ts

diff --git a/astro.config.mjs b/astro.config.mjs
index 46fd34d..74c295a 100644
--- a/astro.config.mjs
+++ b/astro.config.mjs
@@ -4,6 +4,9 @@ import tailwind from '@astrojs/tailwind';
 import vercel from '@astrojs/vercel';
 
 export default defineConfig({
+  // Domaine de production réel — sert de base à Astro.site,
+  // aux canonical et au sitemap.
+  site: 'https://www.trouve-tout-conseil.fr',
   output: 'server',
   adapter: vercel(),
   integrations: [tailwind()],
diff --git a/public/og-default.png b/public/og-default.png
new file mode 100644
index 0000000000000000000000000000000000000000..3ad83d8c089dda5bef322aecb847137742316d0e
GIT binary patch
