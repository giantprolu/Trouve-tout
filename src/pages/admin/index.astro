---
/**
 * Dashboard Admin
 * Route: /admin
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getCategories, getBrands, getProducts, getProductTypes, getBrandsByCategory, type DbCategory, type DbBrand } from '../../lib/db';

// Récupérer les données depuis Supabase
const categories = await getCategories();
const brands = await getBrands();
const products = await getProducts();
const productTypes = await getProductTypes();

// Calculer les stats
const stats = {
    totalProducts: products.length,
    totalCategories: categories.length,
    totalBrands: brands.length,
    totalProductTypes: productTypes.length,
    productsByPosition: {
        'best-value': products.filter(p => p.position === 'best-value').length,
        'middle-ground': products.filter(p => p.position === 'middle-ground').length,
        'budget': products.filter(p => p.position === 'budget').length,
    },
    productsByCategory: Object.fromEntries(
        categories.map(cat => [cat.slug, products.filter(p => p.category_id === cat.id).length])
    )
};

// Enrichir les catégories avec le nombre de marques
interface CategoryWithBrands extends DbCategory {
    brandCount: number;
}

const categoriesWithBrands: CategoryWithBrands[] = await Promise.all(
    categories.map(async (cat): Promise<CategoryWithBrands> => {
        const catBrands = await getBrandsByCategory(cat.slug);
        return {
            ...cat,
            brandCount: catBrands.length
        };
    })
);
---

<AdminLayout title="Dashboard">
    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <div class="bg-white rounded-xl shadow-sm p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500">Total Produits</p>
                    <p class="text-3xl font-bold text-gray-900">{stats.totalProducts}</p>
                </div>
                <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center">
                    <span class="text-2xl">📦</span>
                </div>
            </div>
        </div>
        
        <div class="bg-white rounded-xl shadow-sm p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500">Catégories</p>
                    <p class="text-3xl font-bold text-gray-900">{stats.totalCategories}</p>
                </div>
                <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
                    <span class="text-2xl">📁</span>
                </div>
            </div>
        </div>
        
        <div class="bg-white rounded-xl shadow-sm p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500">Marques</p>
                    <p class="text-3xl font-bold text-gray-900">{stats.totalBrands}</p>
                </div>
                <div class="w-12 h-12 bg-yellow-100 rounded-lg flex items-center justify-center">
                    <span class="text-2xl">🏷️</span>
                </div>
            </div>
        </div>
        
        <div class="bg-white rounded-xl shadow-sm p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500">Types de produits</p>
                    <p class="text-3xl font-bold text-gray-900">{stats.totalProductTypes}</p>
                </div>
                <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
                    <span class="text-2xl">🗂️</span>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Produits par position -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-6">
            <div class="flex items-center gap-3 mb-2">
                <span class="text-2xl">⭐</span>
                <h3 class="font-semibold text-gray-900">Meilleur rapport Q/P</h3>
            </div>
            <p class="text-3xl font-bold text-yellow-700">{stats.productsByPosition['best-value']}</p>
            <p class="text-sm text-gray-600 mt-1">produits</p>
        </div>
        
        <div class="bg-purple-50 border border-purple-200 rounded-xl p-6">
            <div class="flex items-center gap-3 mb-2">
                <span class="text-2xl">⚖️</span>
                <h3 class="font-semibold text-gray-900">Juste milieu</h3>
            </div>
            <p class="text-3xl font-bold text-purple-700">{stats.productsByPosition['middle-ground']}</p>
            <p class="text-sm text-gray-600 mt-1">produits</p>
        </div>
        
        <div class="bg-green-50 border border-green-200 rounded-xl p-6">
            <div class="flex items-center gap-3 mb-2">
                <span class="text-2xl">💸</span>
                <h3 class="font-semibold text-gray-900">Moins cher fiable</h3>
            </div>
            <p class="text-3xl font-bold text-green-700">{stats.productsByPosition['budget']}</p>
            <p class="text-sm text-gray-600 mt-1">produits</p>
        </div>
    </div>
    
    <!-- Actions rapides -->
    <div class="bg-white rounded-xl shadow-sm p-6 mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Actions rapides</h2>
        <div class="flex flex-wrap gap-4">
            <a href="/admin/products/new" class="btn-primary">
                ➕ Ajouter un produit
            </a>
            <a href="/admin/products" class="btn-secondary">
                📋 Voir tous les produits
            </a>
        </div>
    </div>
    
    <!-- Produits par catégorie -->
    <div class="bg-white rounded-xl shadow-sm p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Produits par catégorie</h2>
        <div class="space-y-4">
            {categoriesWithBrands.map(category => (
                <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
                    <div class="flex items-center gap-3">
                        <span class="text-2xl">{category.icon}</span>
                        <div>
                            <p class="font-medium text-gray-900">{category.name}</p>
                            <p class="text-sm text-gray-500">{category.brandCount} marques</p>
                        </div>
                    </div>
                    <div class="text-right">
                        <p class="text-2xl font-bold text-gray-900">
                            {stats.productsByCategory[category.slug] || 0}
                        </p>
                        <p class="text-sm text-gray-500">produits</p>
                    </div>
                </div>
            ))}
        </div>
    </div>
</AdminLayout>
