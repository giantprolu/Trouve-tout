---
import Layout from '../../layouts/Layout.astro';

const title = "Blog | Trouve-Tout";
const description = "Conseils, guides d'achat et actualités pour vous aider à faire les meilleurs choix.";

// Articles de blog (données statiques pour l'instant)
const articles = [
    {
        slug: 'comment-choisir-smartphone-2026',
        title: 'Comment choisir son smartphone en 2026 ?',
        excerpt: 'Guide complet pour choisir le smartphone parfait selon vos besoins et votre budget.',
        image: '/images/blog/smartphone-guide.jpg',
        category: 'High-Tech',
        date: '28 décembre 2025',
        readTime: '8 min'
    },
    {
        slug: 'meilleurs-aspirateurs-sans-fil',
        title: 'Les meilleurs aspirateurs sans fil en 2026',
        excerpt: 'Comparatif des aspirateurs balais : Dyson vs Rowenta vs Xiaomi, lequel choisir ?',
        image: '/images/blog/aspirateurs.jpg',
        category: 'Maison',
        date: '20 décembre 2025',
        readTime: '6 min'
    },
    {
        slug: 'robot-cuisine-thermomix-alternatives',
        title: 'Thermomix : vaut-il son prix ? Les alternatives',
        excerpt: 'Analyse complète du Thermomix TM6 et comparaison avec Moulinex Companion et KitchenAid.',
        image: '/images/blog/robot-cuisine.jpg',
        category: 'Cuisine',
        date: '15 décembre 2025',
        readTime: '10 min'
    },
    {
        slug: 'montres-connectees-sport',
        title: 'Garmin vs Apple Watch : quelle montre pour le sport ?',
        excerpt: 'Comparatif détaillé des montres GPS pour runners, cyclistes et triathlètes.',
        image: '/images/blog/montres-sport.jpg',
        category: 'Sport',
        date: '10 décembre 2025',
        readTime: '7 min'
    },
    {
        slug: 'soins-cheveux-dyson-ghd',
        title: 'Dyson Airwrap vs GHD : le match des coiffeurs',
        excerpt: 'Quel appareil choisir pour des cheveux parfaits ? Notre verdict après 3 mois de test.',
        image: '/images/blog/coiffure.jpg',
        category: 'Beauté',
        date: '5 décembre 2025',
        readTime: '5 min'
    },
    {
        slug: 'guide-cadeaux-noel-2025',
        title: 'Guide cadeaux Noël 2025 : nos meilleures recommandations',
        excerpt: 'Idées cadeaux pour tous les budgets et tous les profils. Ne ratez pas le cadeau parfait !',
        image: '/images/blog/cadeaux-noel.jpg',
        category: 'Guide',
        date: '1 décembre 2025',
        readTime: '12 min'
    }
];

const categories = ['Tous', 'High-Tech', 'Maison', 'Cuisine', 'Sport', 'Beauté', 'Guide'];
---

<Layout title={title} description={description}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <!-- Header -->
        <div class="text-center mb-12">
            <h1 class="text-4xl font-bold text-gray-900 mb-4">
                Blog Trouve-Tout
            </h1>
            <p class="text-xl text-gray-600 max-w-2xl mx-auto">
                Guides d'achat, comparatifs et conseils pour vous aider à faire les meilleurs choix.
            </p>
        </div>

        <!-- Categories Filter -->
        <div class="flex flex-wrap justify-center gap-2 mb-12">
            {categories.map((cat, index) => (
                <button 
                    class={`px-4 py-2 rounded-full font-medium transition-colors ${
                        index === 0 
                            ? 'bg-primary-600 text-white' 
                            : 'bg-gray-100 text-gray-700 hover:bg-gray-200'
                    }`}
                >
                    {cat}
                </button>
            ))}
        </div>

        <!-- Featured Article -->
        <article class="bg-white rounded-2xl shadow-lg overflow-hidden mb-12">
            <div class="grid grid-cols-1 lg:grid-cols-2">
                <div class="h-64 lg:h-auto bg-gradient-to-br from-primary-500 to-secondary-500 flex items-center justify-center">
                    <span class="text-8xl">📱</span>
                </div>
                <div class="p-8 lg:p-12 flex flex-col justify-center">
                    <span class="inline-block bg-primary-100 text-primary-700 text-sm font-medium px-3 py-1 rounded-full mb-4 w-fit">
                        {articles[0].category}
                    </span>
                    <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-4">
                        {articles[0].title}
                    </h2>
                    <p class="text-gray-600 mb-6">
                        {articles[0].excerpt}
                    </p>
                    <div class="flex items-center justify-between">
                        <span class="text-gray-500 text-sm">
                            {articles[0].date} · {articles[0].readTime} de lecture
                        </span>
                        <a 
                            href={`/blog/${articles[0].slug}`}
                            class="bg-primary-600 hover:bg-primary-700 text-white px-6 py-2 rounded-lg font-medium transition-colors"
                        >
                            Lire l'article
                        </a>
                    </div>
                </div>
            </div>
        </article>

        <!-- Articles Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {articles.slice(1).map((article) => (
                <article class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-shadow">
                    <div class="h-48 bg-gradient-to-br from-gray-200 to-gray-300 flex items-center justify-center">
                        <span class="text-6xl">📄</span>
                    </div>
                    <div class="p-6">
                        <span class="inline-block bg-gray-100 text-gray-700 text-xs font-medium px-2 py-1 rounded-full mb-3">
                            {article.category}
                        </span>
                        <h3 class="font-bold text-lg text-gray-900 mb-2 line-clamp-2">
                            {article.title}
                        </h3>
                        <p class="text-gray-600 text-sm mb-4 line-clamp-2">
                            {article.excerpt}
                        </p>
                        <div class="flex items-center justify-between text-sm">
                            <span class="text-gray-500">
                                {article.readTime}
                            </span>
                            <a 
                                href={`/blog/${article.slug}`}
                                class="text-primary-600 hover:text-primary-700 font-medium"
                            >
                                Lire →
                            </a>
                        </div>
                    </div>
                </article>
            ))}
        </div>

        <!-- Newsletter -->
        <div class="mt-16 bg-primary-600 rounded-2xl p-8 lg:p-12 text-center text-white">
            <h2 class="text-2xl lg:text-3xl font-bold mb-4">
                Restez informé !
            </h2>
            <p class="text-primary-100 mb-8 max-w-xl mx-auto">
                Recevez nos meilleurs conseils et les dernières offres directement dans votre boîte mail.
            </p>
            <form class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto">
                <input 
                    type="email" 
                    placeholder="Votre email"
                    class="flex-grow px-4 py-3 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-white"
                />
                <button 
                    type="submit"
                    class="bg-white text-primary-600 px-6 py-3 rounded-lg font-bold hover:bg-gray-100 transition-colors"
                >
                    S'inscrire
                </button>
            </form>
        </div>
    </div>
</Layout>
