---
import Layout from '../../layouts/Layout.astro';
import EnteteCoque from '../../components/EnteteCoque.astro';
import { categories, getGuidesByCategorie } from '../../lib/data';

export const prerender = true;
---
<Layout
  title="Guides d'achat bricolage : nos conseils"
  description="Tous nos guides d'achat bricolage : critères, pièges à éviter et budget réaliste pour chaque outil. Choisissez sans vous tromper."
  hideHeader
>
  <section class="rounded-shell bg-gradient-to-br from-white/80 via-[#F2F4EC]/90 to-[#E9EDDC]/95 shadow-shell p-4 sm:p-6">
    <EnteteCoque />

    <div class="rounded-panel bg-gradient-to-br from-[#F6F8F0] to-[#EDF0E4] shadow-tile p-6 sm:p-8 lg:p-11 mb-4">
      <span class="inline-block rounded-full bg-white/90 px-4 py-2 font-mono text-label uppercase text-accent">
        Guides d'achat
      </span>
      <h1 class="mt-6 font-display font-extrabold text-[clamp(1.875rem,3.8vw,2.75rem)] leading-[1.05] tracking-[-0.03em] text-ink">
        Tous les guides
      </h1>
      <p class="mt-4 max-w-[520px] text-body-lg text-ink/70">
        Des articles qui expliquent les critères de choix — pas un classement de produits.
      </p>
    </div>

    <div class="flex flex-col gap-4">
      {categories.map((cat) => {
        const guidesCategorie = getGuidesByCategorie(cat.slug);
        if (guidesCategorie.length === 0) return null;
        return (
          <div class="rounded-tile bg-card shadow-tile p-6 sm:p-7">
            <p class="m-0 mb-4 font-mono text-label uppercase text-accent">{cat.emoji} {cat.nom}</p>
            <div class="flex flex-wrap gap-4">
              {guidesCategorie.map((g) => (
                <a
                  href={`/blog/${g.slug}`}
                  class="flex-1 min-w-[240px] block hover:opacity-75 transition-opacity"
                >
                  <p class="m-0 font-display font-bold text-block-title text-ink">{g.titre}</p>
                  <p class="mt-2 text-small text-ink/70">{g.description}</p>
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>
</Layout>
