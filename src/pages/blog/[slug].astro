---
import Layout from '../../layouts/Layout.astro';
import { getGuideBySlug, guides, getCategorieBySlug } from '../../lib/data';

const { slug } = Astro.params;
const guide = getGuideBySlug(slug!);
if (!guide) return Astro.redirect('/blog');

const categorie = getCategorieBySlug(guide.categorieSlug);

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.titre,
  description: guide.description,
  author: { '@type': 'Organization', name: 'Trouve-Tout' },
  publisher: { '@type': 'Organization', name: 'Trouve-Tout' },
});
---
<Layout title={guide.titre} description={guide.description}>
  <script is:inline type="application/ld+json" set:html={schema} />

  <div class="max-w-3xl mx-auto px-4 pt-6 text-sm text-gray-500">
    <a href="/" class="hover:text-indigo-600">Accueil</a> ›
    <a href="/blog" class="hover:text-indigo-600 mx-1">Guides</a> ›
    <span class="text-gray-800 font-medium">{guide.titre}</span>
  </div>

  <article class="max-w-3xl mx-auto px-4 py-8">
    <div class="text-sm text-indigo-600 font-medium mb-2">
      {categorie?.emoji} {categorie?.nom}
    </div>
    <h1 class="text-3xl font-bold mb-4">{guide.titre}</h1>
    <p class="text-lg text-gray-600 mb-8 border-l-4 border-indigo-200 pl-4">{guide.intro}</p>

    <div class="space-y-8">
      {guide.sections.map(s => (
        <section>
          <h2 class="text-xl font-bold mb-3">{s.titre}</h2>
          <p class="text-gray-700 leading-relaxed"
            set:html={s.contenu.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')} />
        </section>
      ))}
    </div>

    <div class="mt-12 bg-indigo-50 border border-indigo-100 rounded-2xl p-6 text-center">
      <p class="font-semibold text-indigo-800 mb-3">Prêt à choisir ?</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/choix-express"
          class="bg-indigo-600 text-white px-5 py-2.5 rounded-xl font-medium hover:bg-indigo-700 transition text-sm">
          ⚡ Choix Express
        </a>
        <a href={`/categories/${guide.categorieSlug}`}
          class="bg-white border border-indigo-200 text-indigo-700 px-5 py-2.5 rounded-xl font-medium hover:bg-indigo-50 transition text-sm">
          Voir les comparatifs {categorie?.nom}
        </a>
      </div>
    </div>
  </article>
</Layout>
