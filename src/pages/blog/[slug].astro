---
import Layout from '../../layouts/Layout.astro';
import EnteteCoque from '../../components/EnteteCoque.astro';
import TableauComparatif from '../../components/TableauComparatif.astro';
import EncartPub from '../../components/EncartPub.astro';
import { imageTaille } from '../../lib/image';
import {
  getGuideBySlug,
  guides,
  getCategorieBySlug,
  getProduitsByCategorie,
  niveauConfiance,
  tempsLectureGuide,
} from '../../lib/data';

const { slug } = Astro.params;
const guide = getGuideBySlug(slug!);
if (!guide) return Astro.redirect('/blog');

const categorie = getCategorieBySlug(guide.categorieSlug);
const produitsCategorie = getProduitsByCategorie(guide.categorieSlug)
  .slice()
  .sort((a, b) => niveauConfiance(b) - niveauConfiance(a));
const produitRecommande = produitsCategorie[0];

function ancre(titre: string): string {
  return titre.toLowerCase().replace(/[^a-z0-9]+/g, '-');
}

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.titre,
  description: guide.description,
  author: { '@type': 'Organization', name: 'Trouve-Tout' },
  publisher: { '@type': 'Organization', name: 'Trouve-Tout' },
});

export const prerender = true;

export function getStaticPaths() {
  return guides.map((item) => ({ params: { slug: item.slug } }));
}
---
<Layout title={guide.titre} description={guide.description} hideHeader>
  <script is:inline type="application/ld+json" set:html={schema} />

  <section class="rounded-shell bg-gradient-to-br from-white/80 via-[#F2F4EC]/90 to-[#E9EDDC]/95 shadow-shell p-4 sm:p-6">
    <EnteteCoque />

    <div class="flex flex-wrap gap-4">
      <div class="flex-[3] min-w-0 flex flex-col gap-4">
        <div class="rounded-panel bg-gradient-to-br from-[#F6F8F0] to-[#EDF0E4] shadow-tile p-6 sm:p-8 lg:p-11 flex flex-wrap gap-8">
          <div class="flex-1 min-w-[280px] flex flex-col">
            <span class="self-start rounded-full bg-white/90 px-4 py-2 font-mono text-label uppercase text-accent">
              Guide d'achat · {categorie?.nom}
            </span>
            <h1 class="mt-6 font-display font-extrabold text-[clamp(2rem,4.4vw,3.125rem)] leading-[1.04] tracking-[-0.035em] text-ink text-balance">
              {guide.titre}
            </h1>
            <p class="mt-4 max-w-[460px] text-body-lg text-ink/70">
              {tempsLectureGuide(guide)} minutes de lecture. {guide.intro}
            </p>
            <div class="mt-7 flex flex-wrap gap-2.5">
              {guide.sections.map((s) => (
                <a href={`#${ancre(s.titre)}`} class="rounded-full bg-white px-4.5 py-2 text-small font-semibold text-ink hover:bg-surface transition-colors">
                  {s.titre}
                </a>
              ))}
              {produitRecommande && (
                <a href="#notre-choix" class="rounded-full bg-white px-4.5 py-2 text-small font-semibold text-ink hover:bg-surface transition-colors">
                  Notre choix
                </a>
              )}
            </div>
          </div>
          {produitRecommande?.image && (
            <div class="flex-1 min-w-[240px] min-h-[280px] rounded-lg bg-white flex items-center justify-center p-4">
              <img src={imageTaille(produitRecommande.image, 700)} width="240" height="240" alt="" loading="eager" decoding="async" class="max-h-[280px] w-auto object-contain" />
            </div>
          )}
        </div>

        {guide.sections.map((s) => (
          <section id={ancre(s.titre)} class="rounded-tile bg-card shadow-tile p-6 sm:p-8 flex flex-wrap gap-6">
            <h2 class="flex-1 min-w-[200px] self-start m-0 font-display font-bold text-display-m text-ink">{s.titre}</h2>
            <div class="flex-[2] min-w-[280px]">
              <p
                class="m-0 text-body text-ink leading-[1.7] max-w-[68ch]"
                set:html={s.contenu.replace(/\*\*(.*?)\*\*/g, '<span class="font-mono text-accent">$1</span>')}
              />
            </div>
          </section>
        ))}

        {produitsCategorie.length > 1 && (
          <div id="notre-choix" class="rounded-tile bg-card shadow-tile p-6 sm:p-8 flex flex-wrap-reverse gap-6">
            <div class="flex-[2] min-w-[280px]">
              <TableauComparatif produits={produitsCategorie} />
            </div>
            <div class="flex-1 min-w-[200px]">
              <h2 class="m-0 font-display font-bold text-display-m text-ink">Le comparatif</h2>
              <p class="mt-3 text-small text-ink/70">
                {produitsCategorie.length} outils comparés sur les critères qui changent vraiment à l'usage.
              </p>
            </div>
          </div>
        )}
      </div>

      <div class="flex-1 min-w-[260px] flex flex-col gap-4">
        {produitRecommande && (
          <div class="rounded-tile bg-card shadow-tile p-6">
            <p class="mb-1.5 font-mono text-label uppercase text-accent">Notre choix</p>
            <p class="m-0 font-display font-bold text-block-title text-ink">{produitRecommande.nom}</p>
            <p class="mt-2 mb-5 text-small text-ink/70">{produitRecommande.verdict}</p>
            <a
              href={`/produits/${produitRecommande.slug}`}
              class="w-full flex items-center justify-between gap-3 rounded-full bg-signal pl-5 pr-1.5 py-1.5 transition-transform hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
            >
              <span class="font-display font-bold text-body text-ink">Voir la fiche</span>
              <span class="grid h-[42px] w-[42px] flex-none place-items-center rounded-full bg-ink text-bg" aria-hidden="true">↗</span>
            </a>
          </div>
        )}
        <a
          href="/choix-express"
          class="rounded-tile bg-[repeating-linear-gradient(45deg,#DCE1D2,#DCE1D2_16px,#E8ECDD_16px,#E8ECDD_32px)] shadow-tile p-5 flex items-center justify-between gap-4 transition hover:-translate-y-0.5"
        >
          <span>
            <span class="block font-display font-bold text-body text-ink">Pas le temps de tout lire ?</span>
            <span class="mt-1 block text-small text-ink/70">Trois questions et on tranche pour toi.</span>
          </span>
          <span class="grid h-11 w-11 flex-none place-items-center rounded-full bg-card text-ink" aria-hidden="true">↗</span>
        </a>

        <EncartPub slot="1077057727" class="flex-1 min-h-[250px]" />
      </div>
    </div>
  </section>
</Layout>
