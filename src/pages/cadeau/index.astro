---
export const prerender = false; // Page dynamique SSR

import Layout from '../../layouts/Layout.astro';
import DbProductCard from '../../components/DbProductCard.astro';
import { getCategories, getProducts, type ProductFull } from '../../lib/db';

const title = "Mode Cadeau 🎁 | Trouve-Tout";
const description = "Trouvez le cadeau parfait pour vos proches. Sélectionnez le profil et le budget, nous vous proposons les meilleures idées.";

// Récupérer les paramètres
const url = new URL(Astro.request.url);
const recipient = url.searchParams.get('recipient');
const occasion = url.searchParams.get('occasion');
const budget = url.searchParams.get('budget');

// Mapping des profils vers les slugs de catégories
const recipientProfiles: Record<string, string[]> = {
    'tech-lover': ['high-tech'],
    'home-maker': ['maison-quotidien'],
    'foodie': ['cuisine'],
    'athlete': ['sport-bien-etre'],
    'beauty-fan': ['beaute-soin'],
    'all': ['high-tech', 'maison-quotidien', 'cuisine', 'sport-bien-etre', 'beaute-soin']
};

let giftSuggestions: ProductFull[] = [];

if (recipient && budget) {
    // Récupérer les catégories et produits depuis Supabase
    const categories = await getCategories();
    const allProducts = await getProducts();
    
    // Trouver les catégories correspondant au profil
    const categorySlugs = recipientProfiles[recipient] || recipientProfiles['all'];
    const matchingCategoryIds = categories
        .filter(c => categorySlugs.includes(c.slug))
        .map(c => c.id);
    
    // Filtrer les produits
    giftSuggestions = allProducts.filter(p => {
        // Vérifier la catégorie
        if (!matchingCategoryIds.includes(p.category_id)) return false;
        
        // Filtrer par position selon le budget (puisqu'on n'a pas de prix exact)
        switch (budget) {
            case 'small':
                // Petit budget = produits budget
                return p.position === 'budget';
            case 'medium':
                // Budget moyen = middle-ground
                return p.position === 'middle-ground' || p.position === 'budget';
            case 'large':
                // Beau cadeau = best-value ou middle-ground
                return p.position === 'best-value' || p.position === 'middle-ground';
            case 'luxury':
                // Luxe = best-value en priorité
                return p.position === 'best-value';
            default:
                return true;
        }
    });

    // Trier par meilleur rapport qualité/prix (avg_rating)
    giftSuggestions.sort((a, b) => (b.avg_rating || 0) - (a.avg_rating || 0));
    
    // Limiter à 9 résultats
    giftSuggestions = giftSuggestions.slice(0, 9);
}

const occasions = [
    { value: 'birthday', label: 'Anniversaire', emoji: '🎂' },
    { value: 'christmas', label: 'Noël', emoji: '🎄' },
    { value: 'valentine', label: 'Saint-Valentin', emoji: '❤️' },
    { value: 'mother-father', label: 'Fête des mères/pères', emoji: '👨‍👩‍👧' },
    { value: 'wedding', label: 'Mariage', emoji: '💍' },
    { value: 'other', label: 'Autre occasion', emoji: '🎉' }
];

const recipients = [
    { value: 'tech-lover', label: 'Geek / Fan de tech', emoji: '🤓' },
    { value: 'home-maker', label: 'Casanier(e)', emoji: '🏠' },
    { value: 'foodie', label: 'Gourmet / Cuisinier', emoji: '👨‍🍳' },
    { value: 'athlete', label: 'Sportif(ve)', emoji: '🏃' },
    { value: 'beauty-fan', label: 'Adepte beauté', emoji: '💅' },
    { value: 'all', label: 'Je ne sais pas', emoji: '🤷' }
];

const budgets = [
    { value: 'small', label: 'Petit budget', range: 'Moins de 100€', emoji: '🎁' },
    { value: 'medium', label: 'Budget moyen', range: '100€ - 300€', emoji: '🎁🎁' },
    { value: 'large', label: 'Beau cadeau', range: '300€ - 600€', emoji: '🎁🎁🎁' },
    { value: 'luxury', label: 'Cadeau de luxe', range: 'Plus de 600€', emoji: '💎' }
];
---

<Layout title={title} description={description}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <!-- Header -->
        <div class="text-center mb-12">
            <div class="text-6xl mb-4">🎁</div>
            <h1 class="text-4xl font-bold text-gray-900 mb-4">
                Mode Cadeau
            </h1>
            <p class="text-xl text-gray-600 max-w-2xl mx-auto">
                Trouvez le cadeau parfait ! Dites-nous pour qui et nous vous proposons les meilleures idées.
            </p>
        </div>

        {!recipient || !budget ? (
            <!-- Selection Form -->
            <div class="max-w-2xl mx-auto">
                <form method="GET" class="space-y-8">
                    <!-- Step 1: Occasion -->
                    <div class="bg-white rounded-2xl shadow-lg p-8">
                        <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center">
                            <span class="bg-pink-500 text-white w-8 h-8 rounded-full flex items-center justify-center mr-3 text-sm">1</span>
                            Pour quelle occasion ?
                        </h2>
                        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                            {occasions.map((occ) => (
                                <label class="cursor-pointer">
                                    <input type="radio" name="occasion" value={occ.value} class="peer sr-only" />
                                    <div class="p-4 border-2 border-gray-200 rounded-xl text-center hover:border-pink-300 peer-checked:border-pink-500 peer-checked:bg-pink-50 transition-all">
                                        <div class="text-3xl mb-2">{occ.emoji}</div>
                                        <div class="font-medium text-sm">{occ.label}</div>
                                    </div>
                                </label>
                            ))}
                        </div>
                    </div>

                    <!-- Step 2: Recipient -->
                    <div class="bg-white rounded-2xl shadow-lg p-8">
                        <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center">
                            <span class="bg-pink-500 text-white w-8 h-8 rounded-full flex items-center justify-center mr-3 text-sm">2</span>
                            C'est pour qui ?
                        </h2>
                        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                            {recipients.map((rec) => (
                                <label class="cursor-pointer">
                                    <input type="radio" name="recipient" value={rec.value} class="peer sr-only" required />
                                    <div class="p-4 border-2 border-gray-200 rounded-xl text-center hover:border-pink-300 peer-checked:border-pink-500 peer-checked:bg-pink-50 transition-all">
                                        <div class="text-3xl mb-2">{rec.emoji}</div>
                                        <div class="font-medium text-sm">{rec.label}</div>
                                    </div>
                                </label>
                            ))}
                        </div>
                    </div>

                    <!-- Step 3: Budget -->
                    <div class="bg-white rounded-2xl shadow-lg p-8">
                        <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center">
                            <span class="bg-pink-500 text-white w-8 h-8 rounded-full flex items-center justify-center mr-3 text-sm">3</span>
                            Votre budget ?
                        </h2>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                            {budgets.map((bud) => (
                                <label class="cursor-pointer">
                                    <input type="radio" name="budget" value={bud.value} class="peer sr-only" required />
                                    <div class="p-4 border-2 border-gray-200 rounded-xl text-center hover:border-pink-300 peer-checked:border-pink-500 peer-checked:bg-pink-50 transition-all">
                                        <div class="text-2xl mb-2">{bud.emoji}</div>
                                        <div class="font-medium text-sm">{bud.label}</div>
                                        <div class="text-xs text-gray-500">{bud.range}</div>
                                    </div>
                                </label>
                            ))}
                        </div>
                    </div>

                    <!-- Submit -->
                    <button 
                        type="submit"
                        class="w-full bg-gradient-to-r from-pink-500 to-rose-500 hover:from-pink-600 hover:to-rose-600 text-white py-5 rounded-2xl font-bold text-xl transition-all shadow-lg hover:shadow-xl flex items-center justify-center gap-3"
                    >
                        <span class="text-2xl">🎁</span>
                        Trouver des idées cadeaux
                    </button>
                </form>
            </div>
        ) : (
            <!-- Results -->
            <div class="max-w-6xl mx-auto">
                <div class="bg-gradient-to-r from-pink-50 to-rose-50 border border-pink-200 rounded-2xl p-6 mb-8">
                    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                        <div>
                            <h2 class="font-bold text-xl text-gray-900 mb-2">
                                {giftSuggestions.length > 0 ? (
                                    <>🎁 {giftSuggestions.length} idée{giftSuggestions.length > 1 ? 's' : ''} cadeau{giftSuggestions.length > 1 ? 'x' : ''} !</>
                                ) : (
                                    <>😕 Aucune suggestion trouvée</>
                                )}
                            </h2>
                            <div class="flex flex-wrap gap-3 text-sm">
                                <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-white shadow-sm">
                                    {recipients.find(r => r.value === recipient)?.emoji} {recipients.find(r => r.value === recipient)?.label}
                                </span>
                                {occasion && (
                                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-white shadow-sm">
                                        {occasions.find(o => o.value === occasion)?.emoji} {occasions.find(o => o.value === occasion)?.label}
                                    </span>
                                )}
                                <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-white shadow-sm">
                                    💰 {budgets.find(b => b.value === budget)?.range}
                                </span>
                            </div>
                        </div>
                        <a 
                            href="/cadeau" 
                            class="inline-flex items-center gap-2 bg-white hover:bg-gray-50 text-gray-700 px-6 py-3 rounded-xl font-medium transition-colors shadow-sm border border-gray-200"
                        >
                            🔄 Nouvelle recherche
                        </a>
                    </div>
                </div>

                {giftSuggestions.length > 0 ? (
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                        {giftSuggestions.map((product, index) => (
                            <div class="relative">
                                {index === 0 && (
                                    <span class="absolute -top-2 -left-2 z-10 px-3 py-1 bg-gradient-to-r from-pink-500 to-rose-500 text-white rounded-full font-bold text-sm shadow">
                                        ⭐ Top choix
                                    </span>
                                )}
                                <DbProductCard product={product} showBrand={true} showCategory={true} />
                            </div>
                        ))}
                    </div>
                ) : (
                    <div class="text-center py-16 bg-white rounded-2xl shadow-lg">
                        <div class="text-8xl mb-6">🔍</div>
                        <h3 class="text-2xl font-bold text-gray-900 mb-3">Aucune suggestion trouvée</h3>
                        <p class="text-gray-600 mb-8 max-w-md mx-auto">
                            Nous n'avons pas trouvé de cadeau correspondant à vos critères. Essayez de modifier le profil ou le budget.
                        </p>
                        <a 
                            href="/cadeau" 
                            class="inline-flex items-center gap-2 bg-pink-500 hover:bg-pink-600 text-white px-8 py-4 rounded-xl font-bold text-lg transition-colors"
                        >
                            🎁 Modifier ma recherche
                        </a>
                    </div>
                )}
            </div>
        )}
    </div>
</Layout>
