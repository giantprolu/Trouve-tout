---
import Layout from '../../layouts/Layout.astro';

let saved = false;
let profil = { email: '', name: '', budgetMin: '', budgetMax: '', priorite: 'equilibre' };

// Lire le cookie existant
const cookieHeader = Astro.request.headers.get('cookie') ?? '';
const cookieMatch = cookieHeader.match(/tt_profil=([^;]+)/);
if (cookieMatch) {
  try {
    profil = { ...profil, ...JSON.parse(decodeURIComponent(cookieMatch[1])) };
  } catch { /* cookie invalide */ }
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  profil = {
    email:     (form.get('email') as string) ?? '',
    name:      (form.get('name') as string) ?? '',
    budgetMin: (form.get('budget_min') as string) ?? '',
    budgetMax: (form.get('budget_max') as string) ?? '',
    priorite:  (form.get('priorite') as string) ?? 'equilibre',
  };
  saved = true;
  Astro.response.headers.set(
    'Set-Cookie',
    `tt_profil=${encodeURIComponent(JSON.stringify(profil))}; Path=/; Max-Age=${60 * 60 * 24 * 365}; SameSite=Lax`,
  );
}
---
<Layout title="Mon profil" description="Personnalisez vos préférences pour des recommandations sur mesure.">
  <div class="max-w-xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-2">👤 Mon profil</h1>
    <p class="text-gray-500 mb-8">Configurez vos préférences pour des recommandations personnalisées.</p>

    {saved && (
      <div class="bg-green-50 border border-green-200 text-green-800 rounded-xl px-4 py-3 mb-6 text-sm font-medium">
        ✓ Profil enregistré avec succès.
      </div>
    )}

    <form method="POST" class="space-y-6 bg-white border border-gray-100 rounded-2xl p-6 shadow-sm">
      <div>
        <label class="block font-medium mb-1">Email</label>
        <input type="email" name="email" value={profil.email} placeholder="vous@exemple.com"
          class="w-full border border-gray-300 rounded-xl px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
      </div>

      <div>
        <label class="block font-medium mb-1">Prénom</label>
        <input type="text" name="name" value={profil.name} placeholder="Votre prénom"
          class="w-full border border-gray-300 rounded-xl px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
      </div>

      <div>
        <label class="block font-medium mb-2">Budget habituel (€)</label>
        <div class="flex gap-3 items-center">
          <input type="number" name="budget_min" value={profil.budgetMin} placeholder="Min" min="0"
            class="w-1/2 border border-gray-300 rounded-xl px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          <span class="text-gray-400">–</span>
          <input type="number" name="budget_max" value={profil.budgetMax} placeholder="Max" min="0"
            class="w-1/2 border border-gray-300 rounded-xl px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        </div>
      </div>

      <div>
        <label class="block font-medium mb-2">Priorité globale</label>
        <div class="flex gap-4">
          {[['prix', '💸 Prix'], ['equilibre', '⚖️ Équilibre'], ['qualite', '⭐ Qualité']].map(([val, label]) => (
            <label class="flex-1 border border-gray-200 rounded-xl p-3 text-center cursor-pointer hover:border-indigo-400 has-[:checked]:border-indigo-600 has-[:checked]:bg-indigo-50">
              <input type="radio" name="priorite" value={val} class="sr-only"
                checked={profil.priorite === val} />
              <span class="text-sm font-medium">{label}</span>
            </label>
          ))}
        </div>
      </div>

      <button type="submit"
        class="w-full bg-indigo-600 text-white py-3 rounded-xl font-semibold hover:bg-indigo-700 transition">
        Enregistrer mon profil
      </button>
    </form>
  </div>
</Layout>
