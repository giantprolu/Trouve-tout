---
import Layout from '../../layouts/Layout.astro';

let saved = false;
let profil = { email: '', name: '', budgetMin: '', budgetMax: '', priorite: 'equilibre' };

// Lire le cookie existant
const cookieHeader = Astro.request.headers.get('cookie') ?? '';
const cookieMatch = cookieHeader.match(/tt_profil=([^;]+)/);
if (cookieMatch) {
  try {
    profil = { ...profil, ...JSON.parse(decodeURIComponent(cookieMatch[1])) };
  } catch { /* cookie invalide */ }
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  profil = {
    email:     (form.get('email') as string) ?? '',
    name:      (form.get('name') as string) ?? '',
    budgetMin: (form.get('budget_min') as string) ?? '',
    budgetMax: (form.get('budget_max') as string) ?? '',
    priorite:  (form.get('priorite') as string) ?? 'equilibre',
  };
  saved = true;
  Astro.response.headers.set(
    'Set-Cookie',
    `tt_profil=${encodeURIComponent(JSON.stringify(profil))}; Path=/; Max-Age=${60 * 60 * 24 * 365}; SameSite=Lax`,
  );
}
---
<Layout title="Mon profil" description="Personnalisez vos préférences pour des recommandations sur mesure.">
  <div class="max-w-xl">
    <p class="font-mono text-kicker uppercase text-graphite mb-3">Préférences</p>
    <h1 class="font-display text-display-l text-graphite mb-8">Mon profil</h1>

    {saved && (
      <div class="border border-graphite bg-tole px-4 py-3 mb-6 font-lecture text-lecture text-graphite">
        Profil enregistré.
      </div>
    )}

    <form method="POST" class="space-y-6 bg-tole border-t-[3px] border-cordeau px-6 py-6">
      <div>
        <label class="block font-lecture text-lecture font-semibold text-graphite mb-2">Email</label>
        <input type="email" name="email" value={profil.email} placeholder="vous@exemple.com"
          class="w-full border border-graphite bg-atelier px-4 py-2 font-lecture text-lecture text-graphite focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cordeau" />
      </div>

      <div>
        <label class="block font-lecture text-lecture font-semibold text-graphite mb-2">Prénom</label>
        <input type="text" name="name" value={profil.name} placeholder="Votre prénom"
          class="w-full border border-graphite bg-atelier px-4 py-2 font-lecture text-lecture text-graphite focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cordeau" />
      </div>

      <div>
        <label class="block font-lecture text-lecture font-semibold text-graphite mb-2">Budget habituel (€)</label>
        <div class="flex gap-3 items-center">
          <input type="number" name="budget_min" value={profil.budgetMin} placeholder="Min" min="0"
            class="w-1/2 border border-graphite bg-atelier px-4 py-2 font-lecture text-lecture text-graphite focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cordeau" />
          <span class="text-graphite">–</span>
          <input type="number" name="budget_max" value={profil.budgetMax} placeholder="Max" min="0"
            class="w-1/2 border border-graphite bg-atelier px-4 py-2 font-lecture text-lecture text-graphite focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cordeau" />
        </div>
      </div>

      <div>
        <label class="block font-lecture text-lecture font-semibold text-graphite mb-2">Priorité globale</label>
        <div class="flex gap-3">
          {[['prix', 'Prix'], ['equilibre', 'Équilibre'], ['qualite', 'Qualité']].map(([val, label]) => (
            <label class="flex-1 border border-graphite px-3 py-3 text-center cursor-pointer font-mono text-kicker uppercase text-graphite hover:bg-atelier has-[:checked]:bg-cordeau has-[:checked]:text-atelier has-[:checked]:border-cordeau transition-colors">
              <input type="radio" name="priorite" value={val} class="sr-only"
                checked={profil.priorite === val} />
              {label}
            </label>
          ))}
        </div>
      </div>

      <button type="submit"
        class="w-full border border-cordeau bg-cordeau text-atelier py-3 font-mono text-kicker uppercase hover:bg-graphite hover:border-graphite transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cordeau">
        Enregistrer mon profil
      </button>
    </form>
  </div>
</Layout>
