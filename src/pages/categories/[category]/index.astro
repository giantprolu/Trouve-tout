---
/**
 * Page Catégorie - Affiche les marques disponibles
 * Route: /categories/[category]
 * 
 * Navigation hiérarchique: Catégorie (cette page) → Marques → Types de produits
 */
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import { 
    getCategories, 
    getCategoryBySlug,
    getBrandsByCategory,
    getProductTypesByCategoryAndBrand,
    type DbCategory,
    type DbBrand,
    type DbProductType
} from '../../../lib/db';

// Interface pour les marques enrichies avec leurs types de produits
interface BrandWithProductTypes extends DbBrand {
    productTypes: DbProductType[];
}

// Génération des chemins statiques pour toutes les catégories depuis Supabase
export async function getStaticPaths() {
    const categories = await getCategories();
    return categories.map(category => ({
        params: { category: category.slug }
    }));
}

const { category: categorySlug } = Astro.params;

const category = await getCategoryBySlug(categorySlug);

if (!category) {
    return Astro.redirect('/categories');
}

// Récupérer les marques de cette catégorie
const brands = await getBrandsByCategory(categorySlug);

// Enrichir les marques avec leurs types de produits (via getProductTypesByCategoryAndBrand)
const brandsWithProductTypes: BrandWithProductTypes[] = await Promise.all(
    brands.map(async (brand) => {
        const productTypes = await getProductTypesByCategoryAndBrand(category.id, brand.id);
        return {
            ...brand,
            productTypes
        };
    })
);

// Calculer le nombre total de types de produits (uniques)
const allProductTypesSet = new Set<string>();
brandsWithProductTypes.forEach(b => b.productTypes.forEach(pt => allProductTypesSet.add(pt.id)));
const totalProductTypes = allProductTypesSet.size;

// Récupérer toutes les catégories pour la navigation
const allCategories = await getCategories();

// Breadcrumb
const breadcrumb = [
    { name: 'Accueil', href: '/' },
    { name: 'Catégories', href: '/categories' },
    { name: category.name, href: '' }
];

// SEO
const seoMeta = {
    title: `${category.name} | Trouve-Tout - Comparatifs et avis`,
    description: category.description || `Découvrez les meilleurs produits ${category.name}. Comparatifs, avis et recommandations.`
};
---

<Layout title={seoMeta.title} description={seoMeta.description}>
    <!-- Breadcrumb -->
    <nav class="bg-gray-100 py-3 border-b">
        <div class="max-w-7xl mx-auto px-4">
            <ol class="flex flex-wrap items-center gap-2 text-sm">
                {breadcrumb.map((item, index) => (
                    <li class="flex items-center">
                        {index > 0 && <span class="text-gray-400 mx-2">›</span>}
                        {index === breadcrumb.length - 1 ? (
                            <span class="text-indigo-600 font-medium">{item.name}</span>
                        ) : (
                            <a href={item.href} class="text-gray-600 hover:text-indigo-600 transition-colors">
                                {item.name}
                            </a>
                        )}
                    </li>
                ))}
            </ol>
        </div>
    </nav>
    
    <!-- Header -->
    <section class="bg-gradient-to-br from-indigo-600 via-purple-600 to-pink-500 text-white py-16">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <span class="text-6xl mb-6 block">{category.icon}</span>
            
            <h1 class="text-4xl md:text-5xl font-bold mb-4">
                {category.name}
            </h1>
            
            <p class="text-xl text-white/90 max-w-2xl mx-auto mb-8">
                {category.description}
            </p>
            
            <!-- Stats -->
            <div class="flex justify-center gap-8">
                <div class="bg-white/20 backdrop-blur-sm rounded-xl px-6 py-3">
                    <span class="text-3xl font-bold block">{brands.length}</span>
                    <span class="text-sm text-white/80">Marques</span>
                </div>
                <div class="bg-white/20 backdrop-blur-sm rounded-xl px-6 py-3">
                    <span class="text-3xl font-bold block">{totalProductTypes}</span>
                    <span class="text-sm text-white/80">Types de produits</span>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Liste des marques -->
    <section class="py-12">
        <div class="max-w-7xl mx-auto px-4">
            <div class="text-center mb-10">
                <h2 class="text-3xl font-bold text-gray-900 mb-4">
                    Choisissez une marque
                </h2>
                <p class="text-gray-600 max-w-2xl mx-auto">
                    Sélectionnez la marque qui vous intéresse pour découvrir tous ses produits 
                    dans la catégorie {category.name}.
                </p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {brandsWithProductTypes.map((brand) => (
                    <a 
                        href={`/categories/${categorySlug}/${brand.slug}`}
                        class="group bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1"
                    >
                        <div class="flex items-stretch">
                            <!-- Logo marque -->
                            <div class="w-32 bg-gradient-to-br from-gray-50 to-gray-100 flex items-center justify-center p-6 group-hover:from-indigo-50 group-hover:to-purple-50 transition-colors">
                                <span class="text-4xl font-bold bg-gradient-to-br from-indigo-600 to-purple-600 bg-clip-text text-transparent">
                                    {brand.name.charAt(0)}
                                </span>
                            </div>
                            
                            <!-- Contenu -->
                            <div class="flex-1 p-6">
                                <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-indigo-600 transition-colors">
                                    {brand.name}
                                </h3>
                                <p class="text-gray-600 text-sm mb-4 line-clamp-2">
                                    {brand.description || `Produits ${brand.name} dans la catégorie ${category.name}`}
                                </p>
                                
                                <!-- Types de produits -->
                                <div class="flex flex-wrap gap-2">
                                    {brand.productTypes.slice(0, 4).map((pt) => (
                                        <span class="inline-flex items-center gap-1 bg-gray-100 px-2 py-1 rounded-lg text-xs text-gray-600">
                                            <span>{pt.icon}</span>
                                            <span>{pt.name}</span>
                                        </span>
                                    ))}
                                    {brand.productTypes.length > 4 && (
                                        <span class="inline-flex items-center bg-gray-100 px-2 py-1 rounded-lg text-xs text-gray-500">
                                            +{brand.productTypes.length - 4}
                                        </span>
                                    )}
                                </div>
                                
                                <!-- CTA -->
                                <div class="mt-4 flex items-center justify-between">
                                    <span class="text-sm text-gray-500">
                                        {brand.productTypes.length} types de produits
                                    </span>
                                    <span class="text-indigo-600 font-medium group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                                        Voir <span>→</span>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </a>
                ))}
            </div>
        </div>
    </section>
    
    <!-- Autres catégories -->
    <section class="py-12 bg-gray-50 border-t">
        <div class="max-w-7xl mx-auto px-4">
            <h2 class="text-2xl font-bold text-gray-900 mb-8 text-center">
                Autres catégories
            </h2>
            
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                {allCategories
                    .filter(c => c.slug !== categorySlug)
                    .map(c => (
                        <a 
                            href={`/categories/${c.slug}`}
                            class="bg-white rounded-xl p-4 shadow-sm hover:shadow-lg transition-all duration-300 text-center group"
                        >
                            <span class="text-3xl block mb-2 group-hover:scale-110 transition-transform">
                                {c.icon}
                            </span>
                            <span class="font-medium text-gray-900 group-hover:text-indigo-600 transition-colors">
                                {c.name}
                            </span>
                        </a>
                    ))
                }
            </div>
            
            <!-- Lien retour -->
            <div class="mt-8 text-center">
                <a 
                    href="/categories"
                    class="inline-flex items-center gap-2 text-indigo-600 hover:text-indigo-700 font-medium"
                >
                    ← Toutes les catégories
                </a>
            </div>
        </div>
    </section>
    
    <!-- Section SEO -->
    <section class="py-12 border-t">
        <div class="max-w-4xl mx-auto px-4">
            <div class="prose prose-lg max-w-none">
                <h2 class="text-2xl font-bold text-gray-900 mb-4">
                    Guide d'achat {category.name}
                </h2>
                <p class="text-gray-600 mb-6">
                    {category.description} Notre équipe analyse les meilleurs produits disponibles 
                    sur Amazon pour vous proposer une sélection rigoureuse basée sur les avis clients, 
                    les caractéristiques techniques et le rapport qualité-prix.
                </p>
                
                <h3 class="text-xl font-bold text-gray-900 mb-3">
                    Les marques {category.name} que nous recommandons
                </h3>
                <ul class="text-gray-600 space-y-2">
                    {brandsWithProductTypes.map(brand => (
                        <li>
                            <strong>{brand.name}</strong> : {brand.description ? brand.description.split('.')[0] : `Produits ${brand.name}`}.
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </section>
</Layout>

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
