---
/**
 * Page Type de Produit - Affiche 3 produits depuis les données provisoires
 * Route: /categories/[category]/[brand]/[productType]
 * 
 * Affiche 3 produits basés sur:
 * - ⭐ Meilleur rapport qualité/prix (best-value)
 * - ⚖️ Juste milieu (middle-ground)
 * - 💸 Moins cher fiable (budget)
 */
import Layout from '../../../../layouts/Layout.astro';
import ProvisoireProductCard from '../../../../components/ProvisoireProductCard.astro';
import { 
    allCategories,
    getCategoryBySlug, 
    getBrandBySlug, 
    getProductTypeBySlug,
    getProductsByType,
    positionLabels
} from '../../../../data/provisoire';

// Génération des chemins statiques depuis les données provisoires
export function getStaticPaths() {
    const paths: { params: { category: string; brand: string; productType: string } }[] = [];
    
    for (const category of allCategories) {
        for (const brand of category.brands) {
            for (const productType of brand.productTypes) {
                paths.push({
                    params: {
                        category: category.slug,
                        brand: brand.slug,
                        productType: productType.slug
                    }
                });
            }
        }
    }
    
    return paths;
}

export const prerender = true;

const { category: categorySlug, brand: brandSlug, productType: productTypeSlug } = Astro.params;

const category = getCategoryBySlug(categorySlug);
const brand = getBrandBySlug(categorySlug, brandSlug);
const productType = getProductTypeBySlug(categorySlug, brandSlug, productTypeSlug);
const products = getProductsByType(categorySlug, productTypeSlug);

if (!category || !brand || !productType) {
    return Astro.redirect('/404');
}

// Breadcrumb
const breadcrumb = [
    { name: 'Accueil', href: '/' },
    { name: 'Catégories', href: '/categories' },
    { name: category.name, href: `/categories/${categorySlug}` },
    { name: brand.name, href: `/categories/${categorySlug}/${brandSlug}` },
    { name: productType.name, href: '' }
];

// SEO
const title = `${productType.name} ${brand.name} - Top 3 Recommandations | Trouve-Tout`;
const description = `Découvrez les 3 meilleurs ${productType.name.toLowerCase()} ${brand.name} : meilleur rapport qualité/prix, juste milieu et petit budget. Conseils d'achat personnalisés.`;
---

<Layout title={title} description={description}>
    <!-- Breadcrumb -->
    <nav class="bg-gray-100 py-3 border-b">
        <div class="max-w-7xl mx-auto px-4">
            <ol class="flex flex-wrap items-center gap-2 text-sm">
                {breadcrumb.map((item, index) => (
                    <li class="flex items-center">
                        {index > 0 && <span class="text-gray-400 mx-2">›</span>}
                        {index === breadcrumb.length - 1 ? (
                            <span class="text-indigo-600 font-medium">{item.name}</span>
                        ) : (
                            <a href={item.href} class="text-gray-600 hover:text-indigo-600 transition-colors">
                                {item.name}
                            </a>
                        )}
                    </li>
                ))}
            </ol>
        </div>
    </nav>
    
    <!-- Header -->
    <section class="bg-gradient-to-br from-indigo-600 via-purple-600 to-pink-500 text-white py-16">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <div class="inline-flex items-center gap-3 bg-white/20 backdrop-blur-sm rounded-full px-6 py-2 mb-6">
                <span class="text-3xl">{productType.icon}</span>
                <span class="text-lg font-medium">{brand.name}</span>
            </div>
            
            <h1 class="text-4xl md:text-5xl font-bold mb-4">
                {productType.name} {brand.name}
            </h1>
            
            <p class="text-xl text-white/90 max-w-2xl mx-auto mb-8">
                {productType.description}
            </p>
            
            <div class="flex flex-wrap justify-center gap-4">
                <div class="inline-flex items-center gap-2 bg-yellow-500 px-4 py-2 rounded-full text-sm font-medium text-gray-900">
                    {positionLabels['best-value'].emoji} {positionLabels['best-value'].label}
                </div>
                <div class="inline-flex items-center gap-2 bg-purple-500 px-4 py-2 rounded-full text-sm font-medium text-white">
                    {positionLabels['middle-ground'].emoji} {positionLabels['middle-ground'].label}
                </div>
                <div class="inline-flex items-center gap-2 bg-green-500 px-4 py-2 rounded-full text-sm font-medium text-white">
                    {positionLabels['budget'].emoji} {positionLabels['budget'].label}
                </div>
            </div>
        </div>
    </section>
    
    <!-- Section Explication -->
    <section class="py-8 bg-gray-50 border-b">
        <div class="max-w-7xl mx-auto px-4">
            <div class="bg-white rounded-2xl p-6 shadow-sm">
                <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
                    <span class="text-2xl">🎯</span>
                    Comment nous sélectionnons les produits
                </h2>
                <div class="grid md:grid-cols-3 gap-6">
                    <div class="flex items-start gap-3">
                        <div class="w-10 h-10 bg-yellow-100 rounded-full flex items-center justify-center flex-shrink-0">
                            <span class="text-xl">⭐</span>
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-900">Meilleur rapport Q/P</h3>
                            <p class="text-sm text-gray-600">Le produit offrant le meilleur équilibre qualité-prix</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3">
                        <div class="w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center flex-shrink-0">
                            <span class="text-xl">⚖️</span>
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-900">Juste milieu</h3>
                            <p class="text-sm text-gray-600">Un compromis idéal entre prix et performances</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3">
                        <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center flex-shrink-0">
                            <span class="text-xl">💸</span>
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-900">Moins cher fiable</h3>
                            <p class="text-sm text-gray-600">Le meilleur prix avec une qualité garantie</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Grille des 3 produits -->
    <section class="py-12">
        <div class="max-w-7xl mx-auto px-4">
            <h2 class="text-2xl font-bold text-gray-900 mb-8 text-center">
                Top 3 {productType.name} {brand.name}
            </h2>
            
            {products.length > 0 ? (
                <div class="grid md:grid-cols-3 gap-8">
                    {products.map((product, index) => (
                        <ProvisoireProductCard 
                            product={product} 
                            rank={index + 1}
                        />
                    ))}
                </div>
            ) : (
                <div class="text-center py-16 bg-gray-50 rounded-2xl">
                    <span class="text-6xl mb-4 block">🔜</span>
                    <h3 class="text-xl font-bold text-gray-900 mb-2">Produits à venir</h3>
                    <p class="text-gray-600">Nous préparons notre sélection pour cette catégorie.</p>
                </div>
            )}
        </div>
    </section>
    
    <!-- Section FAQ SEO -->
    <section class="py-12 bg-gray-50">
        <div class="max-w-4xl mx-auto px-4">
            <h2 class="text-2xl font-bold text-gray-900 mb-8 text-center">
                Questions fréquentes sur les {productType.name} {brand.name}
            </h2>
            
            <div class="space-y-4">
                <details class="bg-white rounded-xl p-6 shadow-sm cursor-pointer group">
                    <summary class="font-semibold text-gray-900 list-none flex items-center justify-between">
                        Quel est le meilleur {productType.name.toLowerCase()} {brand.name} ?
                        <span class="text-indigo-600 group-open:rotate-180 transition-transform">▼</span>
                    </summary>
                    <p class="mt-4 text-gray-600">
                        Le meilleur {productType.name.toLowerCase()} {brand.name} dépend de vos besoins et budget. 
                        Notre sélection "Meilleur rapport qualité/prix" offre les meilleures performances pour son prix. 
                        Le "Juste milieu" convient à la plupart des utilisateurs, et le "Moins cher fiable" 
                        est parfait si vous avez un budget limité sans sacrifier la qualité.
                    </p>
                </details>
                
                <details class="bg-white rounded-xl p-6 shadow-sm cursor-pointer group">
                    <summary class="font-semibold text-gray-900 list-none flex items-center justify-between">
                        Où acheter les {productType.name} {brand.name} au meilleur prix ?
                        <span class="text-indigo-600 group-open:rotate-180 transition-transform">▼</span>
                    </summary>
                    <p class="mt-4 text-gray-600">
                        Amazon reste la meilleure plateforme pour acheter des {productType.name.toLowerCase()} {brand.name} 
                        grâce à sa politique de retour, ses garanties et ses prix compétitifs. Les membres Prime 
                        bénéficient en plus de la livraison gratuite et rapide.
                    </p>
                </details>
                
                <details class="bg-white rounded-xl p-6 shadow-sm cursor-pointer group">
                    <summary class="font-semibold text-gray-900 list-none flex items-center justify-between">
                        Comment choisir entre les différents modèles ?
                        <span class="text-indigo-600 group-open:rotate-180 transition-transform">▼</span>
                    </summary>
                    <p class="mt-4 text-gray-600">
                        Considérez votre budget et vos besoins réels. Consultez nos indicateurs (qualité, prix, 
                        durabilité, fiabilité) ainsi que les profils "Recommandé pour" et "Moins adapté pour" 
                        pour chaque produit. Cela vous aidera à choisir le modèle le plus adapté à votre situation.
                    </p>
                </details>
            </div>
        </div>
    </section>
    
    <!-- Navigation vers autres types de produits -->
    <section class="py-12 border-t">
        <div class="max-w-7xl mx-auto px-4">
            <h2 class="text-2xl font-bold text-gray-900 mb-8 text-center">
                Autres produits {brand.name}
            </h2>
            
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                {brand.productTypes
                    .filter(pt => pt.slug !== productTypeSlug)
                    .map(pt => (
                        <a 
                            href={`/categories/${categorySlug}/${brandSlug}/${pt.slug}`}
                            class="bg-white rounded-xl p-4 shadow-sm hover:shadow-lg transition-all duration-300 text-center group"
                        >
                            <span class="text-3xl block mb-2 group-hover:scale-110 transition-transform">
                                {pt.icon}
                            </span>
                            <span class="font-medium text-gray-900">{pt.name}</span>
                        </a>
                    ))
                }
            </div>
            
            <!-- Lien retour marque -->
            <div class="mt-8 text-center">
                <a 
                    href={`/categories/${categorySlug}/${brandSlug}`}
                    class="inline-flex items-center gap-2 text-indigo-600 hover:text-indigo-700 font-medium"
                >
                    ← Retour à tous les produits {brand.name}
                </a>
            </div>
        </div>
    </section>
    
    <!-- Disclaimer affiliation -->
    <section class="py-6 bg-gray-100 border-t">
        <div class="max-w-4xl mx-auto px-4 text-center">
            <p class="text-sm text-gray-500">
                <strong>Transparence :</strong> Trouve-Tout participe au Programme Partenaires d'Amazon, 
                un programme d'affiliation permettant de percevoir des commissions sur les produits achetés 
                via nos liens. Cela ne modifie pas le prix pour vous.
            </p>
        </div>
    </section>
</Layout>
