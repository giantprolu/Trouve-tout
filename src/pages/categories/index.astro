---
/**
 * Page listing toutes les catégories
 * Route: /categories
 */
import Layout from '../../layouts/Layout.astro';
import { getCategories, getBrands, getProductTypes, getBrandsByCategory, type DbCategory, type DbBrand } from '../../lib/db';

const title = "Toutes les Catégories | Trouve-Tout";
const description = "Explorez toutes nos catégories de produits : High-Tech, Maison, Cuisine, Sport et Beauté. Trouvez le produit parfait pour vos besoins.";

// Données depuis Supabase
const categories = await getCategories();
const brands = await getBrands();
const productTypes = await getProductTypes();

// Type pour les catégories enrichies
interface CategoryWithBrands extends DbCategory {
    brands: DbBrand[];
}

// Enrichir les catégories avec leurs marques
const categoriesWithBrands: CategoryWithBrands[] = await Promise.all(
    categories.map(async (cat): Promise<CategoryWithBrands> => {
        const catBrands = await getBrandsByCategory(cat.slug);
        return {
            ...cat,
            brands: catBrands
        };
    })
);

// Stats calculées
const totalBrands = brands.length;
const totalProductTypes = productTypes.length;
---

<Layout title={title} description={description}>
    <!-- Header -->
    <section class="bg-gradient-to-br from-indigo-600 via-purple-600 to-pink-500 text-white py-16">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <h1 class="text-4xl md:text-5xl font-bold mb-4">
                Toutes les Catégories
            </h1>
            <p class="text-xl text-white/90 max-w-2xl mx-auto mb-8">
                Explorez nos différentes catégories de produits et trouvez les meilleures recommandations adaptées à vos besoins.
            </p>
            
            <!-- Stats -->
            <div class="flex justify-center gap-8">
                <div class="bg-white/20 backdrop-blur-sm rounded-xl px-6 py-3">
                    <span class="text-3xl font-bold block">{categories.length}</span>
                    <span class="text-sm text-white/80">Catégories</span>
                </div>
                <div class="bg-white/20 backdrop-blur-sm rounded-xl px-6 py-3">
                    <span class="text-3xl font-bold block">{totalBrands}</span>
                    <span class="text-sm text-white/80">Marques</span>
                </div>
                <div class="bg-white/20 backdrop-blur-sm rounded-xl px-6 py-3">
                    <span class="text-3xl font-bold block">{totalProductTypes}</span>
                    <span class="text-sm text-white/80">Types de produits</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Categories Grid -->
    <section class="py-12">
        <div class="max-w-7xl mx-auto px-4">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {categoriesWithBrands.map((category) => (
                    <a 
                        href={`/categories/${category.slug}`}
                        class="group bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1"
                    >
                        <!-- Header avec icône -->
                        <div class="bg-gradient-to-br from-gray-50 to-gray-100 p-8 text-center border-b group-hover:from-indigo-50 group-hover:to-purple-50 transition-colors">
                            <span class="text-6xl block mb-3 group-hover:scale-110 transition-transform duration-300">
                                {category.icon}
                            </span>
                        </div>
                        
                        <!-- Contenu -->
                        <div class="p-6">
                            <h2 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-indigo-600 transition-colors">
                                {category.name}
                            </h2>
                            <p class="text-gray-600 text-sm mb-4 line-clamp-2">
                                {category.description}
                            </p>
                            
                            <!-- Marques preview -->
                            <div class="flex flex-wrap gap-2 mb-4">
                                {category.brands.slice(0, 3).map((brand) => (
                                    <span class="inline-flex items-center gap-1 bg-gray-100 px-2 py-1 rounded-lg text-xs text-gray-600">
                                        {brand.name}
                                    </span>
                                ))}
                                {category.brands.length > 3 && (
                                    <span class="inline-flex items-center bg-gray-100 px-2 py-1 rounded-lg text-xs text-gray-500">
                                        +{category.brands.length - 3}
                                    </span>
                                )}
                            </div>
                            
                            <!-- Stats -->
                            <div class="flex items-center justify-between text-sm">
                                <span class="text-gray-500">
                                    {category.brands.length} marques
                                </span>
                                <span class="text-indigo-600 font-medium group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                                    Explorer <span>→</span>
                                </span>
                            </div>
                        </div>
                    </a>
                ))}
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="py-12 bg-gray-50 border-t">
        <div class="max-w-7xl mx-auto px-4">
            <h2 class="text-2xl font-bold text-gray-900 text-center mb-8">
                Pourquoi nous faire confiance ?
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="bg-white rounded-2xl p-6 shadow-sm text-center">
                    <div class="w-16 h-16 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <span class="text-3xl">⭐</span>
                    </div>
                    <h3 class="font-bold text-lg mb-2">Meilleure Note</h3>
                    <p class="text-gray-600 text-sm">Nous sélectionnons les produits les mieux notés par les acheteurs Amazon.</p>
                </div>
                <div class="bg-white rounded-2xl p-6 shadow-sm text-center">
                    <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <span class="text-3xl">🏆</span>
                    </div>
                    <h3 class="font-bold text-lg mb-2">Meilleur Rapport Q/P</h3>
                    <p class="text-gray-600 text-sm">Le meilleur compromis entre qualité et prix pour votre budget.</p>
                </div>
                <div class="bg-white rounded-2xl p-6 shadow-sm text-center">
                    <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <span class="text-3xl">💰</span>
                    </div>
                    <h3 class="font-bold text-lg mb-2">Moins Cher Fiable</h3>
                    <p class="text-gray-600 text-sm">Le prix le plus bas avec une note minimum de 4/5 étoiles.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Navigation rapide -->
    <section class="py-12 border-t">
        <div class="max-w-7xl mx-auto px-4">
            <h2 class="text-2xl font-bold text-gray-900 text-center mb-8">
                Accès rapide aux marques populaires
            </h2>
            <div class="flex flex-wrap justify-center gap-3">
                {categoriesWithBrands.flatMap(cat => 
                    cat.brands.slice(0, 2).map(brand => (
                        <a 
                            href={`/categories/${cat.slug}/${brand.slug}`}
                            class="inline-flex items-center gap-2 bg-white px-4 py-2 rounded-full shadow-sm hover:shadow-md transition-all duration-300 text-gray-700 hover:text-indigo-600"
                        >
                            <span>{cat.icon}</span>
                            <span class="font-medium">{brand.name}</span>
                        </a>
                    ))
                )}
            </div>
        </div>
    </section>
</Layout>

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
