---
import Layout from '../../layouts/Layout.astro';

const categories = [
  { slug: 'high-tech', nom: 'High-Tech', emoji: '📱', desc: 'Smartphones, laptops, casques, enceintes…' },
  { slug: 'maison',    nom: 'Maison',    emoji: '🏠', desc: 'Aspirateurs, robots, literie, déco…' },
  { slug: 'cuisine',   nom: 'Cuisine',   emoji: '🍳', desc: 'Friteuses à air, blenders, cafetières…' },
  { slug: 'sport',     nom: 'Sport',     emoji: '🏃', desc: 'Montres connectées, vélos, équipements…' },
  { slug: 'beaute',    nom: 'Beauté',    emoji: '✨', desc: 'Soin peau, lisseurs, rasoirs…' },
];
---
<Layout title="Catégories" description="Toutes les catégories de produits comparés sur Trouve-Tout.">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-8">Toutes les catégories</h1>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {categories.map(cat => (
        <a href={`/categories/${cat.slug}`}
          class="bg-white border border-gray-100 rounded-2xl p-6 shadow-sm hover:shadow-md transition group">
          <div class="text-4xl mb-3">{cat.emoji}</div>
          <h2 class="font-semibold text-lg mb-1 group-hover:text-indigo-600">{cat.nom}</h2>
          <p class="text-sm text-gray-500">{cat.desc}</p>
        </a>
      ))}
    </div>
  </div>
</Layout>
