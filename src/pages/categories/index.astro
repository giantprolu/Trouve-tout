---
import Layout from '../../layouts/Layout.astro';
import { categories } from '../../lib/data';

export const prerender = true;
---
<Layout title="Catégories" description="Toutes les catégories d'outillage et jardin couvertes par Trouve-Tout.">
  <p class="font-mono text-kicker uppercase text-graphite mb-4">Catégories</p>
  <h1 class="font-display text-display-l text-graphite mb-10">Toutes les catégories</h1>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    {categories.map(cat => (
      <a href={`/categories/${cat.slug}`} class="bg-tole border-t-[3px] border-cordeau px-6 py-6 block hover:bg-cordeau-light/40 transition-colors">
        <h2 class="font-display text-display-m text-graphite mb-2">{cat.nom}</h2>
        <p class="font-lecture text-lecture text-graphite">{cat.description}</p>
      </a>
    ))}
  </div>
</Layout>
