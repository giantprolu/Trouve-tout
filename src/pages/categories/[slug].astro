---
import Layout from '../../layouts/Layout.astro';
import EnteteCoque from '../../components/EnteteCoque.astro';
import CarrouselProduits from '../../components/CarrouselProduits.astro';
import EncartPub from '../../components/EncartPub.astro';
import { imageTaille } from '../../lib/image';
import { absoluteUrl } from '../../lib/site';
import {
  getCategorieBySlug,
  getMarquesByCategorie,
  getProduitsByCategorie,
  getGuidesByCategorie,
  niveauConfiance,
  categories,
} from '../../lib/data';

const { slug } = Astro.params;
const categorie = getCategorieBySlug(slug!);
if (!categorie) return Astro.redirect('/categories');

const marquesListe = getMarquesByCategorie(slug!);
const guidesCategorie = getGuidesByCategorie(slug!);

// Carrousel : tous les produits de la categorie, marques et prix confondus,
// tries du moins cher au plus cher pour donner un vrai parcours budgetaire.
const produitsCategorie = getProduitsByCategorie(slug!).sort((a, b) => a.prixIndicatif - b.prixIndicatif);

// Photo de la categorie : le produit le plus digne de confiance parmi ceux
// qui ont une vraie photo (les fiches encore verifie:false n'en ont pas).
const produitVedette = produitsCategorie
  .filter((p) => p.image)
  .sort((a, b) => niveauConfiance(b) - niveauConfiance(a))[0];

const breadcrumb = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: absoluteUrl('/') },
    { '@type': 'ListItem', position: 2, name: categorie.nom, item: absoluteUrl(`/categories/${categorie.slug}`) },
  ],
});

export const prerender = true;

export function getStaticPaths() {
  return categories.map((item) => ({ params: { slug: item.slug } }));
}
---
<Layout title={`${categorie.nom} — ${categorie.sousTitre}`} description={categorie.description} hideHeader>
  <script is:inline type="application/ld+json" set:html={breadcrumb} />
  <section class="rounded-shell bg-gradient-to-br from-white/80 via-[#F2F4EC]/90 to-[#E9EDDC]/95 shadow-shell p-4 sm:p-6">
    <EnteteCoque />

    <div class="flex flex-col lg:flex-row gap-4">
      <div class="flex-[3] min-w-0 flex flex-col gap-4">
        <div class="rounded-panel bg-gradient-to-br from-[#F6F8F0] to-[#EDF0E4] shadow-tile p-6 sm:p-8 lg:p-11 flex flex-wrap gap-8">
          <div class="flex-1 min-w-[280px] flex flex-col">
            <span class="self-start rounded-full bg-white/90 px-4 py-2 font-mono text-label uppercase text-accent">
              {categorie.sousTitre}
            </span>
            <h1 class="mt-6 font-display font-extrabold text-[clamp(2rem,4.4vw,3.125rem)] leading-[1.04] tracking-[-0.035em] text-ink">
              {categorie.emoji} {categorie.nom}
            </h1>
            <p class="mt-4 max-w-[460px] text-body-lg text-ink/70">{categorie.description}</p>
            {marquesListe.length > 0 && (
              <div class="mt-7 flex flex-wrap gap-2.5">
                {marquesListe.map((m) => (
                  <a href={`/marques/${m.slug}`} class="inline-flex items-center gap-[9px] rounded-full border border-[#C3C9BC] bg-white/55 py-2 pl-3.5 pr-4 text-small font-semibold text-ink transition-colors duration-150 hover:bg-white hover:border-accent">
                    <span class="h-[13px] w-0.5 rounded-[1px] bg-accent"></span>
                    {m.nom}
                  </a>
                ))}
              </div>
            )}
          </div>
          {produitVedette && (
            <div data-img-box class="flex-1 min-w-[240px] min-h-[240px] rounded-lg bg-white flex items-center justify-center p-4">
              <img src={imageTaille(produitVedette.image!, 700)} width="240" height="240" alt={produitVedette.nom} loading="eager" fetchpriority="high" decoding="async" class="max-h-[240px] w-auto object-contain" onerror="this.closest('[data-img-box]').style.display='none'" />
            </div>
          )}
        </div>

        <div class="rounded-tile bg-card shadow-tile p-6 sm:p-8 flex flex-col gap-2">
          <h2 class="m-0 font-display font-bold text-display-m text-ink">Les produits {categorie.nom.toLowerCase()}</h2>
          <p class="mt-1 mb-2 max-w-xl text-small text-ink/70">Toutes marques et tous budgets confondus, du moins cher au plus premium.</p>
          <CarrouselProduits produits={produitsCategorie} />
        </div>
      </div>

      <div class="flex-1 min-w-[260px] flex flex-col gap-4">
        {guidesCategorie.length > 0 && (
          <div class="rounded-tile bg-card shadow-tile p-6">
            <p class="m-0 mb-4 font-display font-bold text-block-title text-ink">Guides {categorie.nom.toLowerCase()}</p>
            <div class="flex flex-col gap-4">
              {guidesCategorie.map((g) => (
                <a href={`/blog/${g.slug}`} class="block hover:opacity-75 transition-opacity">
                  <p class="m-0 font-body font-semibold text-body text-ink">{g.titre}</p>
                  <p class="mt-1 text-small text-ink/65">{g.description}</p>
                </a>
              ))}
            </div>
          </div>
        )}
        <a
          href="/choix-express"
          class="rounded-tile bg-[repeating-linear-gradient(45deg,#DCE1D2,#DCE1D2_16px,#E8ECDD_16px,#E8ECDD_32px)] shadow-tile p-5 flex items-center justify-between gap-4 transition hover:-translate-y-0.5"
        >
          <span>
            <span class="block font-display font-bold text-body text-ink">Pas le temps de comparer ?</span>
            <span class="mt-1 block text-small text-ink/70">Trois questions et on tranche pour toi.</span>
          </span>
          <span class="grid h-11 w-11 flex-none place-items-center rounded-full bg-card text-ink" aria-hidden="true">↗</span>
        </a>

        <EncartPub slot="1077057727" class="flex-1 min-h-[250px]" />
      </div>
    </div>
  </section>
</Layout>
