---
import Layout from '../layouts/Layout.astro';
import EncartTransparence from '../components/EncartTransparence.astro';
import {
  categories,
  guides,
  produits,
  getGuideBySlug,
  getProduitsByCategorie,
} from '../lib/data';
import { BORNES_BUDGET } from '../lib/affiliation';

export const prerender = true;

// Guide « à la une » : sert de fil rouge à la section héro. Choisi en dur ici
// plutôt que par un vrai mécanisme de rotation, qu'on n'a pas construit.
const guideVedette = getGuideBySlug('tondeuse-batterie-thermique-filaire')!;
const guideSecondaire = getGuideBySlug('quelle-perceuse-visseuse-choisir')!;

const produitsJardin = getProduitsByCategorie(guideVedette.categorieSlug);
const prixMin = Math.min(...produitsJardin.map((p) => p.prixIndicatif));
const prixMax = Math.max(...produitsJardin.map((p) => p.prixIndicatif));

// Temps de lecture estimé à partir du vrai contenu (≈ 200 mots/min), pas un
// chiffre inventé : voir la règle d'honnêteté du contenu dans CLAUDE.md.
function tempsLecture(guide: typeof guideVedette): number {
  const texte = guide.intro + ' ' + guide.sections.map((s) => s.contenu).join(' ');
  const mots = texte.split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.round(mots / 200));
}

const tranchesBudget = BORNES_BUDGET.map((borne, i) =>
  i === 0 ? `moins de ${borne} €` : `${BORNES_BUDGET[i - 1]} – ${borne} €`,
).concat(`plus de ${BORNES_BUDGET[BORNES_BUDGET.length - 1]} €`);
---
<Layout
  title="Bien choisir son outillage"
  description="Guides d'achat outillage et jardin : les critères qui comptent vraiment, sans jargon et sans classement bidon."
>
  <section class="rounded-shell bg-gradient-to-br from-white/80 via-[#F2F4EC]/90 to-[#E9EDDC]/95 shadow-shell p-4 sm:p-6 mb-10">
    <div class="flex flex-col lg:flex-row gap-4">
      <div class="flex-[3] min-w-0 flex flex-col gap-4">
        <div class="rounded-panel bg-gradient-to-br from-[#F6F8F0] to-[#EDF0E4] shadow-tile p-6 sm:p-8 lg:p-11 flex flex-wrap gap-8">
          <div class="flex-1 min-w-[280px] flex flex-col">
            <span class="self-start rounded bg-white/90 px-4 py-2 font-mono text-label uppercase text-accent">
              Guide à la une
            </span>
            <h1 class="mt-6 font-display font-extrabold text-[clamp(2.25rem,5vw,3.625rem)] leading-[1.02] tracking-[-0.035em] text-ink text-balance">
              Choisis ta tondeuse sans te tromper.
            </h1>
            <p class="mt-4 max-w-md text-body-lg text-ink/70">
              {guideVedette.description}
            </p>
            <div class="mt-10 max-w-md">
              <div class="h-px bg-line/60 relative">
                <span class="absolute left-0 top-3 font-mono text-label text-line">{prixMin} €</span>
                <span class="absolute right-0 top-3 font-mono text-label text-line">{prixMax} €</span>
              </div>
            </div>
            <div class="mt-12 flex flex-wrap items-center gap-4">
              <a
                href={`/blog/${guideVedette.slug}`}
                class="inline-flex items-center gap-3 rounded-full bg-accent pl-6 pr-1.5 py-1.5 shadow-tile transition-transform hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
              >
                <span class="font-display font-bold text-body-lg text-bg">Lire le guide tondeuses</span>
                <span class="grid h-11 w-11 place-items-center rounded-full bg-ink text-bg" aria-hidden="true">↗</span>
              </a>
              <span class="font-mono text-data text-ink/55">{tempsLecture(guideVedette)} min de lecture</span>
            </div>
          </div>
          <div class="flex-1 min-w-[220px] min-h-[280px] rounded-lg bg-[repeating-linear-gradient(45deg,#E3E7DA,#E3E7DA_14px,#F0F3E8_14px,#F0F3E8_28px)]"></div>
        </div>

        <div class="flex flex-wrap gap-4">
          <a
            href="/choix-express"
            class="flex-1 min-w-[240px] rounded-tile bg-card shadow-tile p-6 flex items-center justify-between gap-5 transition hover:-translate-y-0.5 hover:shadow-tile-hover"
          >
            <div>
              <p class="font-display font-bold text-display-m text-ink">Choix express</p>
              <p class="mt-2 text-body text-ink/65">Trois questions : ton terrain, ton budget, ta fréquence.</p>
            </div>
            <span class="grid h-11 w-11 flex-none place-items-center rounded-full bg-surface text-ink" aria-hidden="true">↗</span>
          </a>
          <a
            href="/blog"
            class="flex-1 min-w-[240px] rounded-tile bg-card shadow-tile p-6 flex items-center justify-between gap-5 transition hover:-translate-y-0.5 hover:shadow-tile-hover"
          >
            <div>
              <p class="font-display font-bold text-display-m text-ink">Tous les guides</p>
              <p class="mt-2 text-body text-ink/65">{produits.length} outils analysés, {guides.length} guides détaillés.</p>
            </div>
            <span class="grid h-11 w-11 flex-none place-items-center rounded-full bg-surface text-ink" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="flex-1 min-w-[260px] flex flex-col gap-4">
        <div class="rounded-tile bg-card shadow-tile p-6">
          <p class="mb-5 font-display font-bold text-block-title text-ink">Par tranche de budget</p>
          <div class="flex flex-col gap-4">
            {tranchesBudget.map((label) => (
              <a href="/choix-express" class="flex items-center gap-3 hover:opacity-70 transition-opacity">
                <span class="min-w-[110px] font-mono text-data text-ink">{label}</span>
                <span class="h-px flex-1 bg-line/30"></span>
              </a>
            ))}
          </div>
        </div>

        <a
          href={`/blog/${guideSecondaire.slug}`}
          class="flex-1 min-h-[300px] rounded-tile bg-[repeating-linear-gradient(45deg,#DCE1D2,#DCE1D2_16px,#E8ECDD_16px,#E8ECDD_32px)] shadow-tile p-6 flex flex-col justify-between transition hover:-translate-y-0.5"
        >
          <span class="self-end grid h-11 w-11 place-items-center rounded-full bg-card text-ink" aria-hidden="true">↗</span>
          <span>
            <span class="block font-display font-bold text-display-m text-ink">{guideSecondaire.titre}</span>
            <span class="mt-2 block text-body text-ink/70">{guideSecondaire.description}</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <EncartTransparence />

  <section class="py-10 border-t border-line/40 mt-10">
    <p class="font-mono text-label uppercase text-ink mb-6">Guides récents</p>
    <div class="flex flex-col sm:flex-row gap-6">
      {guides.slice(0, 3).map((g, i) => (
        <a
          href={`/blog/${g.slug}`}
          class={`bg-surface border-t-[3px] border-accent px-5 py-5 block hover:bg-accent/10 transition-colors ${i === 0 ? 'sm:flex-[1.4]' : 'sm:flex-1'}`}
        >
          <h2 class="font-display text-display-m text-ink mb-2">{g.titre}</h2>
          <p class="font-body text-small text-ink">{g.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="py-10 border-t border-line/40">
    <p class="font-mono text-label uppercase text-ink mb-6">Par type d'outil</p>
    <div class="flex flex-col divide-y divide-line/30">
      {categories.map((c) => (
        <a href={`/categories/${c.slug}`} class="py-5 flex items-baseline gap-4 group">
          <h2 class="font-display text-display-m text-ink group-hover:text-accent transition-colors">
            {c.nom}
          </h2>
          <p class="font-body text-body text-ink">{c.sousTitre}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
