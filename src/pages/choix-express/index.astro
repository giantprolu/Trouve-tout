---
import Layout from '../../layouts/Layout.astro';
import EnteteCoque from '../../components/EnteteCoque.astro';
import CTAAffilie from '../../components/CTAAffilie.astro';
import EncartTransparence from '../../components/EncartTransparence.astro';
import TrancheBudget from '../../components/TrancheBudget.astro';
import { imageTaille } from '../../lib/image';
import {
  recommanderChoixExpress,
  categories,
  produits,
  getCategorieBySlug,
} from '../../lib/data';

const BUDGETS: { valeur: string; label: string }[] = [
  { valeur: '100', label: 'Moins de 100 €' },
  { valeur: '300', label: '100 – 300 €' },
  { valeur: '600', label: '300 – 600 €' },
  { valeur: '9999', label: '+ de 600 €' },
];
const PRIORITES: { valeur: string; label: string }[] = [
  { valeur: 'prix', label: 'Prix bas' },
  { valeur: 'equilibre', label: 'Équilibré' },
  { valeur: 'qualite', label: 'Qualité max' },
];

let resultat = null;
let alternatives: ReturnType<typeof recommanderChoixExpress>[] = [];
let erreur = '';
let valeurs = { categorie: '', budget: '300', priorite: 'equilibre' };

// Formulaire en GET plutôt qu'en POST : ce questionnaire n'a aucun effet de
// bord (pas d'écriture, pas de compte), donc GET est sémantiquement correct
// et le résultat reste partageable/rechargeable par son URL. Ça évite aussi
// la protection anti-CSRF d'Astro (bloque les POST cross-origine) qui
// déclenchait « Cross-site POST form submissions are forbidden » — rien à
// voir avec l'affiliation ManoMano en attente.
const params = Astro.url.searchParams;
if (params.has('categorie')) {
  const categorie = params.get('categorie') ?? '';
  const budget    = parseInt(params.get('budget') ?? '0', 10);
  const priorite  = params.get('priorite') ?? '';
  valeurs = { categorie, budget: String(budget), priorite };

  resultat = recommanderChoixExpress(categorie, budget, priorite);
  if (!resultat) {
    erreur = `Aucun produit trouvé dans cette catégorie sous ${budget} €. Essayez un budget plus élevé.`;
  } else {
    alternatives = produits
      .filter(p => p.categorieSlug === categorie && p.prixIndicatif <= budget && p.slug !== resultat!.slug)
      .slice(0, 2);
  }
}

const budgetsAvecCompte = BUDGETS.map((b) => ({
  ...b,
  nbOutils: produits.filter((p) => p.prixIndicatif <= parseInt(b.valeur, 10)).length,
}));

const categorieChoisie = valeurs.categorie ? getCategorieBySlug(valeurs.categorie) : undefined;
const budgetLabel = BUDGETS.find(b => b.valeur === valeurs.budget)?.label ?? '';
const prioriteLabel = PRIORITES.find(p => p.valeur === valeurs.priorite)?.label ?? '';
---
<Layout title="Choix Express" description="3 questions, 1 recommandation personnalisée — sans compte." hideHeader>
  <section class="rounded-shell bg-gradient-to-br from-white/80 via-[#F2F4EC]/90 to-[#E9EDDC]/95 shadow-shell p-4 sm:p-6">
    <EnteteCoque />

    {!resultat && (
      <div class="flex flex-col lg:flex-row gap-4">
        <div class="flex-[3] min-w-0 rounded-panel bg-gradient-to-br from-[#F6F8F0] to-[#EDF0E4] shadow-tile p-6 sm:p-8 lg:p-11">
          <span class="inline-block rounded-full bg-white/90 px-4 py-2 font-mono text-label uppercase text-accent">
            Choix express · 3 questions rapides
          </span>
          <h1 class="mt-6 max-w-[580px] font-display font-extrabold text-[clamp(1.875rem,3.8vw,2.75rem)] leading-[1.05] tracking-[-0.03em] text-ink">
            Quel outil te faut-il ?
          </h1>
          <p class="mt-4 max-w-[520px] text-body-lg text-ink/70">
            Catégorie, budget, priorité : trois réponses et on te propose un seul outil, avec la raison qui va avec.
          </p>

          <form method="GET" class="mt-9 flex flex-col gap-9">
            <div>
              <p class="mb-3 font-mono text-label uppercase text-ink">Quelle catégorie ?</p>
              <div class="flex flex-wrap gap-3">
                {categories.map((c) => (
                  <label class="flex-1 min-w-[180px] flex flex-col gap-2 rounded-[18px] border border-[#D5DAC9] bg-card px-5 py-5 cursor-pointer transition hover:-translate-y-0.5 has-[:checked]:border-accent">
                    <input type="radio" name="categorie" value={c.slug} class="sr-only" checked={valeurs.categorie === c.slug} required />
                    <span class="font-display font-bold text-body text-ink">{c.emoji} {c.nom}</span>
                    <span class="text-small text-ink/65">{c.sousTitre}</span>
                  </label>
                ))}
              </div>
            </div>

            <div>
              <p class="mb-3 font-mono text-label uppercase text-ink">Budget maximum ?</p>
              <div class="flex flex-wrap gap-3">
                {budgetsAvecCompte.map((b) => (
                  <label class="flex-1 min-w-[160px] flex flex-col gap-2 rounded-[18px] border border-[#D5DAC9] bg-card px-5 py-5 cursor-pointer transition hover:-translate-y-0.5 has-[:checked]:border-accent">
                    <input type="radio" name="budget" value={b.valeur} class="sr-only" checked={valeurs.budget === b.valeur} required />
                    <span class="font-display font-bold text-body text-ink">{b.label}</span>
                    <span class="mt-auto pt-2 font-mono text-label text-line">{b.nbOutils} outils du site</span>
                  </label>
                ))}
              </div>
            </div>

            <div>
              <p class="mb-3 font-mono text-label uppercase text-ink">Priorité ?</p>
              <div class="flex flex-wrap gap-3">
                {PRIORITES.map((p) => (
                  <label class="flex-1 min-w-[140px] flex items-center justify-center rounded-[18px] border border-[#D5DAC9] bg-card px-5 py-5 cursor-pointer text-center transition hover:-translate-y-0.5 has-[:checked]:border-accent has-[:checked]:bg-surface">
                    <input type="radio" name="priorite" value={p.valeur} class="sr-only" checked={valeurs.priorite === p.valeur} required />
                    <span class="font-display font-bold text-body text-ink">{p.label}</span>
                  </label>
                ))}
              </div>
            </div>

            {erreur && (
              <div class="coin-coupe border border-dashed border-line bg-bg px-5 py-4">
                <p class="font-mono text-label uppercase text-ink mb-2">Pas de résultat</p>
                <p class="m-0 text-small text-ink/80">{erreur}</p>
              </div>
            )}

            <button
              type="submit"
              class="self-start inline-flex items-center gap-3.5 rounded-full bg-ink pl-6 pr-1.5 py-1.5 transition-transform hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              <span class="font-display font-bold text-body text-bg">Voir ce qu'on te conseille</span>
              <span class="grid h-[46px] w-[46px] place-items-center rounded-full bg-signal text-ink" aria-hidden="true">→</span>
            </button>
          </form>
        </div>

        <div class="flex-1 min-w-[260px] flex flex-col gap-4">
          <div class="rounded-tile bg-card shadow-tile p-6">
            <p class="m-0 mb-5 font-display font-bold text-block-title text-ink">Comment ça marche</p>
            <p class="m-0 text-small text-ink/70 leading-relaxed">
              Trois questions, une seule recommandation. On croise ton budget et ta priorité avec les outils qu'on a
              analysés dans la catégorie choisie — pas de classement générique.
            </p>
          </div>
          <div class="rounded-tile bg-[repeating-linear-gradient(45deg,#DCE1D2,#DCE1D2_16px,#E8ECDD_16px,#E8ECDD_32px)] shadow-tile p-6 flex-1 min-h-[200px] flex items-end">
            <p class="m-0 text-body text-ink/72">
              Aucune donnée gardée, aucun compte à créer. Tu peux refermer la page sans rien perdre.
            </p>
          </div>
        </div>
      </div>
    )}

    {resultat && (
      <div class="flex flex-col lg:flex-row gap-4">
        <div class="flex-[3] min-w-0 flex flex-col gap-4">
          <div class="rounded-panel bg-gradient-to-br from-[#F6F8F0] to-[#EDF0E4] shadow-tile p-6 sm:p-8 lg:p-11">
            <span class="inline-block rounded-full bg-white/90 px-4 py-2 font-mono text-label uppercase text-accent">
              {categorieChoisie?.nom} · {budgetLabel} · priorité {prioriteLabel.toLowerCase()}
            </span>
            <h1 class="mt-6 max-w-[620px] font-display font-extrabold text-[clamp(1.875rem,3.8vw,2.75rem)] leading-[1.05] tracking-[-0.03em] text-ink text-balance">
              Voici ce qu'on te propose, et pourquoi.
            </h1>

            <div class="mt-8 rounded-tile bg-card shadow-tile px-6 py-6 flex flex-wrap gap-7">
              <div class="flex-1 min-w-[280px]">
                <p class="m-0 font-display font-extrabold text-[1.625rem] leading-[1.15] tracking-[-0.02em] text-ink">
                  {resultat.nom}
                </p>
                <p class="mt-3 text-body text-ink/75 leading-[1.65]">{resultat.description}</p>
                <div class="mt-9 max-w-[400px]">
                  <TrancheBudget produit={resultat} />
                </div>
                <div class="mt-8 flex flex-wrap items-center gap-4">
                  <CTAAffilie url={resultat.urlMarchand} marchand={resultat.marchand} />
                  <a href={`/produits/${resultat.slug}`} class="font-body font-semibold text-small text-accent hover:text-ink transition-colors">
                    Lire la fiche complète
                  </a>
                </div>
              </div>
              {resultat.image && (
                <div class="flex-1 min-w-[220px] min-h-[240px] rounded-lg bg-white flex items-center justify-center p-4">
                  <img src={imageTaille(resultat.image, 500)} width="220" height="220" alt={resultat.nom} class="max-h-[220px] w-auto object-contain" decoding="async" />
                </div>
              )}
            </div>
          </div>
        </div>

        <div class="flex-1 min-w-[260px] flex flex-col gap-4">
          {alternatives.length > 0 && (
            <div class="rounded-tile bg-card shadow-tile p-6">
              <p class="m-0 mb-3.5 font-display font-bold text-block-title text-ink">Si tu préfères plutôt</p>
              <div class="flex flex-col gap-3">
                {alternatives.map((alt) => (
                  <p class="m-0 text-small text-ink/72 leading-relaxed">
                    <a href={`/produits/${alt!.slug}`} class="font-semibold text-ink hover:text-accent transition-colors">{alt!.nom}</a> — {alt!.contreQui}
                  </p>
                ))}
              </div>
            </div>
          )}
          <a
            href="/choix-express"
            class="rounded-tile bg-[repeating-linear-gradient(45deg,#DCE1D2,#DCE1D2_16px,#E8ECDD_16px,#E8ECDD_32px)] shadow-tile p-6 min-h-[180px] flex flex-col justify-between transition hover:-translate-y-0.5"
          >
            <span class="self-end grid h-11 w-11 place-items-center rounded-full bg-card text-ink" aria-hidden="true">↻</span>
            <span>
              <span class="block font-display font-bold text-display-m text-ink">Changer une réponse</span>
              <span class="mt-2 block text-body text-ink/70">Le conseil se recalcule aussitôt.</span>
            </span>
          </a>
          <EncartTransparence />
        </div>
      </div>
    )}
  </section>
</Layout>
