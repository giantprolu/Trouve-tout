---
import Layout from '../../layouts/Layout.astro';
import VerdictProduit from '../../components/VerdictProduit.astro';
import NiveauABulle from '../../components/NiveauABulle.astro';
import { recommanderChoixExpress, categories, niveauConfiance } from '../../lib/data';

let resultat = null;
let erreur = '';
let valeurs = { categorie: '', budget: '300', priorite: 'equilibre' };

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const categorie = form.get('categorie') as string;
  const budget    = parseInt(form.get('budget') as string, 10);
  const priorite  = form.get('priorite') as string;
  valeurs = { categorie, budget: String(budget), priorite };

  resultat = recommanderChoixExpress(categorie, budget, priorite);
  if (!resultat) erreur = `Aucun produit trouvé dans cette catégorie sous ${budget} €. Essayez un budget plus élevé.`;
}
---
<Layout title="Choix Express" description="3 questions, 1 recommandation personnalisée — sans compte.">
  <div class="max-w-xl">
    <p class="font-mono text-kicker uppercase text-graphite mb-3">3 questions, sans compte</p>
    <h1 class="font-display text-display-l text-graphite mb-8">Choix Express</h1>

    {!resultat && (
      <form method="POST" class="space-y-8">
        <div>
          <label class="block font-lecture text-lecture font-semibold text-graphite mb-2">Quelle catégorie ?</label>
          <select name="categorie" required
            class="w-full border border-graphite bg-atelier px-4 py-3 font-lecture text-lecture text-graphite focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cordeau">
            <option value="">Choisir…</option>
            {categories.map(c => (
              <option value={c.slug} selected={valeurs.categorie === c.slug}>
                {c.nom} — {c.sousTitre}
              </option>
            ))}
          </select>
        </div>

        <div>
          <label class="block font-lecture text-lecture font-semibold text-graphite mb-2">Budget maximum ?</label>
          <select name="budget" required
            class="w-full border border-graphite bg-atelier px-4 py-3 font-lecture text-lecture text-graphite focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cordeau">
            <option value="100">Moins de 100 €</option>
            <option value="300" selected>100 – 300 €</option>
            <option value="600">300 – 600 €</option>
            <option value="9999">+ de 600 €</option>
          </select>
        </div>

        <div>
          <label class="block font-lecture text-lecture font-semibold text-graphite mb-2">Priorité ?</label>
          <div class="flex gap-3">
            {[['prix', 'Prix bas'], ['equilibre', 'Équilibré'], ['qualite', 'Qualité max']].map(([val, label]) => (
              <label class="flex-1 border border-graphite px-3 py-3 text-center cursor-pointer font-mono text-kicker uppercase text-graphite hover:bg-tole has-[:checked]:bg-cordeau has-[:checked]:text-atelier has-[:checked]:border-cordeau transition-colors">
                <input type="radio" name="priorite" value={val} class="sr-only"
                  checked={valeurs.priorite === val} required />
                {label}
              </label>
            ))}
          </div>
        </div>

        {erreur && (
          <div class="border border-graphite bg-tole px-4 py-3 font-lecture text-lecture text-graphite">
            {erreur}
          </div>
        )}

        <button type="submit"
          class="w-full border border-cordeau bg-cordeau text-atelier py-3 font-mono text-kicker uppercase hover:bg-graphite hover:border-graphite transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cordeau">
          Trouver mon produit →
        </button>
      </form>
    )}

    {resultat && (
      <div>
        <p class="font-mono text-legende text-graphite mb-6">
          Vos réponses : {valeurs.categorie} · sous {valeurs.budget} € · priorité {valeurs.priorite}
        </p>

        <div class="flex justify-center mb-8">
          <NiveauABulle niveau={niveauConfiance(resultat)} taille="hero" />
        </div>

        <h2 class="font-display text-display-l text-graphite mb-3 text-center">Ce qu'on vous conseille</h2>
        <p class="font-lecture text-lecture text-graphite mb-8 text-center">{resultat.verdict}</p>

        <VerdictProduit produit={resultat} />

        <div class="mt-8 text-center">
          <a href="/choix-express" class="font-mono text-kicker uppercase text-graphite hover:text-cordeau transition-colors">
            ← Refaire le test
          </a>
        </div>
      </div>
    )}
  </div>
</Layout>
