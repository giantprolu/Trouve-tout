---
import Layout from '../../layouts/Layout.astro';
import EnteteCoque from '../../components/EnteteCoque.astro';
import TableauComparatif from '../../components/TableauComparatif.astro';
import VerdictProduit from '../../components/VerdictProduit.astro';
import LogoMarque from '../../components/LogoMarque.astro';
import EncartPub from '../../components/EncartPub.astro';
import {
  getMarqueBySlug,
  getProduitsByMarque,
  getCategorieBySlug,
  marques,
} from '../../lib/data';

const { slug } = Astro.params;
const marque = getMarqueBySlug(slug!);
if (!marque) return Astro.redirect('/marques');

const produitsDuMarque = getProduitsByMarque(slug!);
const categorie = getCategorieBySlug(marque.categorieSlugs[0]);

export const prerender = true;

export function getStaticPaths() {
  return marques.map((item) => ({ params: { slug: item.slug } }));
}
---
<Layout title={`${marque.nom} — ${marque.positionnement}`} description={marque.description} hideHeader>
  <section class="rounded-shell bg-gradient-to-br from-white/80 via-[#F2F4EC]/90 to-[#E9EDDC]/95 shadow-shell p-4 sm:p-6">
    <EnteteCoque />

    <div class="flex flex-wrap gap-4">
      <div class="flex-[3] min-w-0 flex flex-col gap-4">
        <div class="rounded-panel bg-gradient-to-br from-[#F6F8F0] to-[#EDF0E4] shadow-tile p-6 sm:p-8 lg:p-11 flex flex-wrap gap-8">
          <div class="flex-1 min-w-[280px] flex flex-col">
            <span class="self-start rounded-full bg-white/90 px-4 py-2 font-mono text-label uppercase text-accent">
              {marque.positionnement}
            </span>
            <h1 class="mt-6 font-display font-extrabold text-[clamp(2rem,4.4vw,3.125rem)] leading-[1.04] tracking-[-0.035em] text-ink">
              {marque.nom}
            </h1>
            <p class="mt-4 max-w-[460px] text-body-lg text-ink/70">{marque.description}</p>
          </div>
          <div class="flex-1 min-w-[240px] min-h-[200px] rounded-lg bg-white flex items-center justify-center p-4">
            <LogoMarque slug={marque.slug} nom={marque.nom} size={96} />
          </div>
        </div>

        <div class="rounded-tile bg-card shadow-tile p-6 sm:p-8 flex flex-col gap-6">
          <h2 class="m-0 font-display font-bold text-display-m text-ink">
            Comparatif des {produitsDuMarque.length} modèles
          </h2>
          <TableauComparatif produits={produitsDuMarque} />
        </div>

        <div class="rounded-tile bg-card shadow-tile p-6 sm:p-8">
          <h2 class="m-0 mb-6 font-display font-bold text-display-m text-ink">Détail de chaque modèle</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {produitsDuMarque.map((p, i) => (
              <VerdictProduit produit={p} numero={i + 1} />
            ))}
          </div>
        </div>
      </div>

      <div class="flex-1 min-w-[260px] flex flex-col gap-4">
        <a
          href={`/categories/${marque.categorieSlugs[0]}`}
          class="rounded-tile bg-card shadow-tile p-6 flex items-center justify-between gap-5 transition hover:-translate-y-0.5 hover:shadow-tile-hover"
        >
          <div>
            <p class="m-0 font-display font-bold text-display-m text-ink">{categorie?.nom}</p>
            <p class="mt-2 text-body text-ink/65">Voir toute la catégorie et les autres marques.</p>
          </div>
          <span class="grid h-11 w-11 flex-none place-items-center rounded-full bg-surface text-ink" aria-hidden="true">↗</span>
        </a>
        <a
          href="/choix-express"
          class="flex-1 min-h-[200px] rounded-tile bg-[repeating-linear-gradient(45deg,#DCE1D2,#DCE1D2_16px,#E8ECDD_16px,#E8ECDD_32px)] shadow-tile p-6 flex flex-col justify-between transition hover:-translate-y-0.5"
        >
          <span class="self-end grid h-11 w-11 place-items-center rounded-full bg-card text-ink" aria-hidden="true">↗</span>
          <span>
            <span class="block font-display font-bold text-display-m text-ink">Pas sûr(e) que ce soit la bonne marque ?</span>
            <span class="mt-2 block text-body text-ink/70">Trois questions et on tranche pour toi.</span>
          </span>
        </a>
        <EncartPub slot="1077057729" class="flex-1 min-h-[250px]" />
      </div>
    </div>
  </section>
</Layout>
