---
import Layout from '../../layouts/Layout.astro';
import TableauComparatif from '../../components/TableauComparatif.astro';
import VerdictProduit from '../../components/VerdictProduit.astro';
import {
  getMarqueBySlug,
  getProduitsByMarque,
  getCategorieBySlug,
  marques,
} from '../../lib/data';

const { slug } = Astro.params;
const marque = getMarqueBySlug(slug!);
if (!marque) return Astro.redirect('/marques');

const produitsDuMarque = getProduitsByMarque(slug!);
const categorie = getCategorieBySlug(marque.categorieSlugs[0]);

export const prerender = true;

export function getStaticPaths() {
  return marques.map((item) => ({ params: { slug: item.slug } }));
}
---
<Layout
  title={`${marque.nom} — ${marque.positionnement}`}
  description={marque.description}
>
  <nav class="font-mono text-small text-ink mb-6" aria-label="Fil d'ariane">
    <a href="/" class="hover:text-accent transition-colors">Accueil</a> ›
    <a href="/marques" class="hover:text-accent transition-colors mx-1">Marques</a> ›
    <span class="text-ink">{marque.nom}</span>
  </nav>

  <div class="mb-12">
    <p class="font-mono text-label uppercase text-ink mb-3">{marque.positionnement}</p>
    <h1 class="font-display text-display-l text-ink mb-3">{marque.nom}</h1>
    <p class="font-body text-body-lg text-ink max-w-2xl">{marque.description}</p>
  </div>

  <section class="mb-12 border-t border-ink pt-8">
    <p class="font-mono text-label uppercase text-ink mb-6">
      Comparatif des {produitsDuMarque.length} modèles
    </p>
    <TableauComparatif produits={produitsDuMarque} />
  </section>

  <section class="border-t border-ink pt-8">
    <p class="font-mono text-label uppercase text-ink mb-6">Détail de chaque modèle</p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {produitsDuMarque.map((p, i) => (
        <VerdictProduit produit={p} numero={i + 1} />
      ))}
    </div>
  </section>

  <div class="mt-12 border-t border-ink pt-6">
    <a href={`/categories/${marque.categorieSlugs[0]}`} class="font-mono text-label uppercase text-accent hover:text-ink transition-colors">
      ← Voir la catégorie {categorie?.nom}
    </a>
  </div>
</Layout>
