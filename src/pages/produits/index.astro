---
import Layout from '../../layouts/Layout.astro';
import { categories, getProduitsByCategorie } from '../../lib/data';
import { fourchettePrix } from '../../lib/affiliation';

export const prerender = true;
---
<Layout title="Tous les produits" description="Toutes les fiches produits comparées sur Trouve-Tout, par catégorie.">
  <p class="font-mono text-label uppercase text-ink mb-4">Produits</p>
  <h1 class="font-display text-display-l text-ink mb-10">Tous les produits</h1>

  {categories.map(cat => {
    const produitsCat = getProduitsByCategorie(cat.slug);
    return (
      <section class="mb-12 border-t border-ink pt-8">
        <div class="flex items-baseline justify-between gap-4 mb-5">
          <h2 class="font-display text-display-m text-ink">{cat.nom}</h2>
          <a href={`/categories/${cat.slug}`} class="font-mono text-label uppercase text-accent hover:text-ink transition-colors shrink-0">
            Voir la catégorie →
          </a>
        </div>
        <ul class="flex flex-col divide-y divide-line/30">
          {produitsCat.map(p => (
            <li>
              <a href={`/produits/${p.slug}`} class="py-4 flex items-baseline justify-between gap-4 group">
                <span class="font-body text-body font-semibold text-ink group-hover:text-accent transition-colors">
                  {p.nom}
                </span>
                <span class="font-mono text-data text-ink shrink-0">{fourchettePrix(p.prixIndicatif)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    );
  })}
</Layout>
