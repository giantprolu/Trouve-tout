---
import Layout from '../../layouts/Layout.astro';
import VerdictProduit from '../../components/VerdictProduit.astro';
import TableauComparatif from '../../components/TableauComparatif.astro';
import {
  getProduitBySlug,
  getMarqueBySlug,
  getCategorieBySlug,
  getProduitsByMarque,
  produits,
} from '../../lib/data';

const { slug } = Astro.params;
const produit = getProduitBySlug(slug!);
if (!produit) return Astro.redirect('/categories');

const marque = getMarqueBySlug(produit.marqueSlug);
const categorie = getCategorieBySlug(produit.categorieSlug);
const autresDuMarque = getProduitsByMarque(produit.marqueSlug).filter(p => p.slug !== produit.slug);

// Schema.org Product JSON-LD
const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: produit.nom,
  description: produit.description,
  brand: { '@type': 'Brand', name: marque?.nom },
  // Pas de bloc `offers` : declarer un prix fige et `InStock` sans flux
  // marchand temps reel, c'est du balisage faux (risque d'action manuelle Google).
  // Pas de bloc `aggregateRating` non plus : une note editoriale maison avec
  // ratingCount:1 est consideree comme un avis auto-attribue et sanctionnee.
  // A remettre quand un flux produit reel alimentera la page.
});

export const prerender = true;

export function getStaticPaths() {
  return produits.map((item) => ({ params: { slug: item.slug } }));
}
---
<Layout
  title={`${produit.nom} — Avis et comparatif`}
  description={`${produit.verdict} — ${produit.description}`}
>
  <script is:inline type="application/ld+json" set:html={schema} />

  <nav class="font-mono text-small text-ink mb-6" aria-label="Fil d'ariane">
    <a href="/" class="hover:text-accent transition-colors">Accueil</a> ›
    <a href={`/categories/${produit.categorieSlug}`} class="hover:text-accent transition-colors mx-1">{categorie?.nom}</a> ›
    <a href={`/marques/${produit.marqueSlug}`} class="hover:text-accent transition-colors mx-1">{marque?.nom}</a> ›
    <span class="text-ink">{produit.nom}</span>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2">
      <h1 class="font-display text-display-l text-ink mb-6">{produit.nom}</h1>

      <div class="mb-8">
        <VerdictProduit produit={produit} />
      </div>

      {autresDuMarque.length > 0 && (
        <section>
          <p class="font-mono text-label uppercase text-ink mb-4">
            Comparaison avec les autres {marque?.nom}
          </p>
          <TableauComparatif produits={autresDuMarque} />
        </section>
      )}
    </div>

    <aside class="lg:col-span-1">
      <div class="bg-bg border border-ink px-5 py-5">
        <p class="font-body text-body text-ink mb-3">
          <strong>Pas sûr(e) ?</strong>
        </p>
        <a href="/choix-express" class="font-mono text-label uppercase text-accent hover:text-ink transition-colors">
          Utiliser le Choix Express →
        </a>
      </div>
    </aside>
  </div>
</Layout>
