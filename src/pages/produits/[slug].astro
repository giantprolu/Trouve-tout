---
import Layout from '../../layouts/Layout.astro';
import VerdictProduit from '../../components/VerdictProduit.astro';
import TableauComparatif from '../../components/TableauComparatif.astro';
import CTAAmazon from '../../components/CTAAmazon.astro';
import {
  getProduitBySlug,
  getMarqueBySlug,
  getCategorieBySlug,
  getProduitsByMarque,
  produits,
} from '../../lib/data';

const { slug } = Astro.params;
const produit = getProduitBySlug(slug!);
if (!produit) return Astro.redirect('/categories');

const marque = getMarqueBySlug(produit.marqueSlug);
const categorie = getCategorieBySlug(produit.categorieSlug);
const autresDuMarque = getProduitsByMarque(produit.marqueSlug);

// Schema.org Product JSON-LD
const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: produit.nom,
  description: produit.description,
  brand: { '@type': 'Brand', name: marque?.nom },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'EUR',
    price: produit.prix,
    availability: 'https://schema.org/InStock',
    url: produit.lienAmazon,
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: ((produit.qualite + produit.durabilite + produit.fiabilite) / 3).toFixed(1),
    bestRating: 5,
    worstRating: 1,
    ratingCount: 1,
  },
});

export const prerender = true;

export function getStaticPaths() {
  return produits.map((item) => ({ params: { slug: item.slug } }));
}
---
<Layout
  title={`${produit.nom} — Avis et comparatif`}
  description={`${produit.verdict} — ${produit.description} Prix : ${produit.prix} €.`}
>
  <script is:inline type="application/ld+json" set:html={schema} />

  <!-- Breadcrumb -->
  <div class="max-w-4xl mx-auto px-4 pt-6 text-sm text-gray-500">
    <a href="/" class="hover:text-indigo-600">Accueil</a> ›
    <a href={`/categories/${produit.categorieSlug}`} class="hover:text-indigo-600 mx-1">{categorie?.nom}</a> ›
    <a href={`/marques/${produit.marqueSlug}`} class="hover:text-indigo-600 mx-1">{marque?.nom}</a> ›
    <span class="text-gray-800 font-medium">{produit.nom}</span>
  </div>

  <div class="max-w-4xl mx-auto px-4 py-8 grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main -->
    <div class="lg:col-span-2 space-y-8">
      <div>
        <h1 class="text-3xl font-bold mb-1">{produit.nom}</h1>
        <div class="text-3xl font-bold text-indigo-600 mb-3">{produit.prix.toLocaleString('fr-FR')} €</div>
        <p class="text-gray-600">{produit.description}</p>
      </div>

      <!-- Indicateurs -->
      <div class="bg-gray-50 rounded-2xl p-6 grid grid-cols-3 gap-4">
        {[
          { label: '⭐ Qualité', val: produit.qualite },
          { label: '🔧 Durabilité', val: produit.durabilite },
          { label: '🛠 Fiabilité/SAV', val: produit.fiabilite },
        ].map(({ label, val }) => (
          <div class="text-center">
            <div class="text-sm text-gray-500 mb-2">{label}</div>
            <div class="text-2xl font-bold text-indigo-600">{val}/5</div>
            <div class="flex justify-center gap-1 mt-1">
              {Array.from({ length: 5 }).map((_, i) => (
                <div class={`w-3 h-3 rounded-full ${i < val ? 'bg-indigo-500' : 'bg-gray-200'}`} />
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Pour qui / Contre qui -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="bg-green-50 border border-green-100 rounded-xl p-4">
          <div class="font-semibold text-green-800 mb-2">✓ Idéal pour</div>
          <p class="text-green-700 text-sm">{produit.pourQui}</p>
        </div>
        <div class="bg-red-50 border border-red-100 rounded-xl p-4">
          <div class="font-semibold text-red-800 mb-2">✗ Moins adapté si</div>
          <p class="text-red-700 text-sm">{produit.contreQui}</p>
        </div>
      </div>

      <!-- Comparaison avec les autres produits de la marque -->
      <div>
        <h2 class="text-xl font-bold mb-4">Comparaison avec les autres {marque?.nom}</h2>
        <TableauComparatif produits={autresDuMarque} />
      </div>
    </div>

    <!-- Sidebar -->
    <div class="lg:col-span-1 space-y-4">
      <div class="bg-white border border-gray-100 rounded-2xl p-6 shadow-sm sticky top-4">
        <div class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Notre verdict</div>
        <div class="text-lg font-bold text-indigo-600 mb-3">{produit.verdict}</div>
        <div class="text-3xl font-bold mb-4">{produit.prix.toLocaleString('fr-FR')} €</div>
        <CTAAmazon lien={produit.lienAmazon} label={`Voir sur Amazon`} />
        <p class="text-xs text-gray-400 mt-3">
          Lien affilié — votre prix ne change pas.
        </p>
      </div>

      <div class="bg-indigo-50 border border-indigo-100 rounded-xl p-4 text-sm text-indigo-800">
        <strong>Pas sûr(e) ?</strong><br />
        <a href="/choix-express" class="underline">Utilise le Choix Express</a> pour une recommandation personnalisée.
      </div>
    </div>
  </div>
</Layout>
