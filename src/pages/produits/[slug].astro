---
import Layout from '../../layouts/Layout.astro';
import EnteteCoque from '../../components/EnteteCoque.astro';
import TableauComparatif from '../../components/TableauComparatif.astro';
import TrancheBudget from '../../components/TrancheBudget.astro';
import { imageTaille } from '../../lib/image';
import CTAAffilie from '../../components/CTAAffilie.astro';
import EncartTransparence from '../../components/EncartTransparence.astro';
import Cote from '../../components/Cote.astro';
import {
  getProduitBySlug,
  getMarqueBySlug,
  getCategorieBySlug,
  getGuidesByCategorie,
  getProduitsByMarque,
  produits,
  niveauConfiance,
  SEGMENT_LABEL,
} from '../../lib/data';
import { prixActuel, lienAffilie, imageActuelle } from '../../lib/affiliation';
import { absoluteUrl } from '../../lib/site';

const { slug } = Astro.params;
const produit = getProduitBySlug(slug!);
if (!produit) return Astro.redirect('/categories');

const marque = getMarqueBySlug(produit.marqueSlug);
const categorie = getCategorieBySlug(produit.categorieSlug);
const autresDuMarque = getProduitsByMarque(produit.marqueSlug).filter(
  p => p.slug !== produit.slug && p.categorieSlug === produit.categorieSlug,
);
const guideCategorie = getGuidesByCategorie(produit.categorieSlug)[0];
const backHref = guideCategorie ? `/blog/${guideCategorie.slug}` : `/categories/${produit.categorieSlug}`;
const backLabel = guideCategorie ? `← Retour au guide ${categorie?.nom.toLowerCase()}` : `← Retour à ${categorie?.nom}`;
const score = Math.round(niveauConfiance(produit) * 10);
const image = imageActuelle(produit);

// Schema.org Product JSON-LD
const prix = prixActuel(produit);
const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: produit.nom,
  description: produit.description,
  brand: { '@type': 'Brand', name: marque?.nom },
  ...(image && { image: imageTaille(image, 900) }),
  ...(prix.ean && { gtin13: prix.ean }),
  // `offers` uniquement quand une synchronisation Awin fraîche existe
  // (scripts/sync-prix.mjs) : le prix et la disponibilité déclarés ici
  // doivent toujours correspondre exactement à ce qui est affiché sur la
  // page (voir prixActuel dans lib/affiliation.ts), sinon Google sanctionne
  // le mismatch. Sinon, on retombe sur la fourchette sans jamais déclarer
  // `offers` avec une valeur approximative.
  ...(prix.exact && {
    offers: {
      '@type': 'Offer',
      price: prix.valeur,
      priceCurrency: 'EUR',
      availability: prix.enStock === false ? 'https://schema.org/OutOfStock' : 'https://schema.org/InStock',
      url: lienAffilie(produit.marchand, produit.urlMarchand),
    },
  }),
  // Pas de bloc `review`/`aggregateRating` : aucun avis n'a jamais ete
  // collecte sur ce site, une note maison avec ratingCount:1 est un avis
  // auto-attribue sanctionne par Google. Pas de `shippingDetails` ni
  // `hasMerchantReturnPolicy` sur `offers` : la livraison et les retours
  // sont geres par le marchand (ManoMano/Amazon), pas par Trouve-Tout, on
  // n'a pas ces donnees et ne peut pas les garantir exactes par fiche.
  // Ces 4 champs sont signales "non critique" par Search Console (n'empechent
  // pas l'affichage), ce sont des suggestions, pas des erreurs a combler en
  // inventant des donnees.
});

const breadcrumb = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: absoluteUrl('/') },
    ...(categorie
      ? [{ '@type': 'ListItem', position: 2, name: categorie.nom, item: absoluteUrl(`/categories/${categorie.slug}`) }]
      : []),
    { '@type': 'ListItem', position: categorie ? 3 : 2, name: produit.nom, item: absoluteUrl(`/produits/${produit.slug}`) },
  ],
});

export const prerender = true;

export function getStaticPaths() {
  return produits.map((item) => ({ params: { slug: item.slug } }));
}

// Le titre final ajoute encore " — Trouve-Tout" (Layout) : au-dela de 60-70
// caracteres, Google tronque le <title> dans les resultats de recherche.
// Beaucoup de noms de produits sont deja longs (specs incluses) — on
// n'ajoute le suffixe descriptif que quand il reste de la marge, plutot que
// de raccourcir le nom du produit lui-meme (donnee factuelle, pas du texte
// editorial a reecrire).
const titre = produit.nom.length <= 40 ? `${produit.nom} — Avis et comparatif` : produit.nom;
---
<Layout
  title={titre}
  description={`${produit.verdict} — ${produit.description}`}
  hideHeader
  noindex={!produit.verifie}
>
  <script is:inline type="application/ld+json" set:html={schema} />
  <script is:inline type="application/ld+json" set:html={breadcrumb} />

  <section class="rounded-shell bg-gradient-to-br from-white/80 via-[#F2F4EC]/90 to-[#E9EDDC]/95 shadow-shell p-4 sm:p-6">
    <EnteteCoque />

    <div class="flex flex-col lg:flex-row gap-4">
      <div class="flex-[3] min-w-0 flex flex-col gap-4">
        <div class="rounded-panel bg-gradient-to-br from-[#F6F8F0] to-[#EDF0E4] shadow-tile p-6 sm:p-8 lg:p-10 flex flex-wrap gap-8">
          <div class="flex-1 min-w-[280px] flex flex-col">
            <a href={backHref} class="self-start text-small font-semibold text-accent hover:text-ink transition-colors">
              {backLabel}
            </a>
            <h1 class="mt-5 font-display font-extrabold text-[clamp(1.875rem,3.6vw,2.625rem)] leading-[1.06] tracking-[-0.03em] text-ink">
              {produit.nom}
            </h1>
            <p class="mt-2 font-mono text-data text-line">{marque?.nom} · {SEGMENT_LABEL[produit.segment]}</p>

            <div class="mt-6 max-w-[420px]">
              <TrancheBudget produit={produit} />
            </div>

            <div class="mt-8 self-start">
              <CTAAffilie url={produit.urlMarchand} marchand={produit.marchand} />
            </div>
          </div>
          {image && (
            <div data-img-box class="flex-1 min-w-[260px] min-h-[300px] rounded-lg bg-white flex items-center justify-center p-4">
              <img src={imageTaille(image, 900)} width="280" height="280" alt={produit.nom} loading="eager" fetchpriority="high" class="max-h-[280px] w-auto object-contain" onload="window.masquerSiNoimage(this)" />
            </div>
          )}
        </div>

        <div class="rounded-tile bg-card shadow-tile p-6 sm:p-8 flex flex-wrap gap-6">
          <h2 class="flex-1 min-w-[200px] self-start m-0 font-display font-bold text-display-m text-ink">Ce que ça change vraiment</h2>
          <div class="flex-[2] min-w-[280px]">
            <p class="m-0 text-body text-ink leading-[1.7] max-w-[68ch]">{produit.description}</p>
          </div>
        </div>

        {autresDuMarque.length > 0 && (
          <div class="rounded-tile bg-card shadow-tile p-6 sm:p-8 flex flex-wrap-reverse gap-6">
            <div class="flex-[2] min-w-[280px]">
              <TableauComparatif produits={[produit, ...autresDuMarque]} />
            </div>
            <div class="flex-1 min-w-[200px]">
              <h2 class="m-0 font-display font-bold text-display-m text-ink">Face aux autres {marque?.nom}</h2>
              <p class="mt-3 text-small text-ink/70">
                Les critères qui font une vraie différence à l'usage, pas juste sur la fiche technique.
              </p>
            </div>
          </div>
        )}
      </div>

      <div class="flex-1 min-w-[260px] flex flex-col gap-4">
        <div class="coin-coupe bg-surface border border-line px-6 py-6">
          <p class="font-mono text-label uppercase text-accent mb-2">Pour qui ?</p>
          <p class="m-0 text-body-lg text-ink">{produit.pourQui}</p>
          <p class="mt-4 font-display font-bold text-block-title text-ink">{produit.verdict}</p>
          <p class="mt-2 text-small text-ink/60">Moins pertinent pour : {produit.contreQui}</p>
          <div class="mt-9">
            <Cote valeur={score} max={10} label={`${score}/10`} />
          </div>
        </div>

        <div class="rounded-tile bg-card shadow-tile p-6">
          <p class="m-0 mb-3 font-display font-bold text-block-title text-ink">La marque {marque?.nom}</p>
          <p class="m-0 mb-2 font-body font-semibold text-small text-ink">{marque?.positionnement}</p>
          <p class="m-0 text-small text-ink/70">{marque?.description}</p>
        </div>

        <EncartTransparence />
      </div>
    </div>
  </section>
</Layout>
