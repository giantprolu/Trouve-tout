---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import DbProductCard from '../../components/DbProductCard.astro';
import AddToCompare from '../../components/AddToCompare.astro';
import { getProductBySlug, getProductsByBrand, POSITION_LABELS, type ProductFull } from '../../lib/db';

const { id } = Astro.params;

// id est en fait le slug du produit
const product = await getProductBySlug(id || '');

if (!product) {
    return Astro.redirect('/produits');
}

// Produits similaires de la même marque
let relatedProducts: ProductFull[] = [];
if (product.brand) {
    const brandProducts = await getProductsByBrand(product.category?.slug || '', product.brand.slug);
    relatedProducts = brandProducts.filter(p => p.id !== product.id).slice(0, 3);
}

const positionInfo = POSITION_LABELS[product.position];

const title = `${product.name} - Avis et Prix | Trouve-Tout`;
const description = product.summary || `Découvrez ${product.name} : caractéristiques, avis et meilleur prix.`;
---

<Layout title={title} description={description}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <!-- Breadcrumb -->
        <nav class="mb-8">
            <ol class="flex items-center space-x-2 text-sm text-gray-500 flex-wrap">
                <li><a href="/" class="hover:text-primary-600">Accueil</a></li>
                <li>/</li>
                <li><a href="/produits" class="hover:text-primary-600">Produits</a></li>
                {product.category && (
                    <>
                        <li>/</li>
                        <li><a href={`/categories/${product.category.slug}`} class="hover:text-primary-600">{product.category.name}</a></li>
                    </>
                )}
                {product.brand && (
                    <>
                        <li>/</li>
                        <li><a href={`/categories/${product.category?.slug}/${product.brand.slug}`} class="hover:text-primary-600">{product.brand.name}</a></li>
                    </>
                )}
                <li>/</li>
                <li class="text-gray-900 font-medium truncate max-w-[200px]">{product.name}</li>
            </ol>
        </nav>

        <!-- Product Detail -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
            <!-- Image -->
            <div class="bg-white rounded-2xl shadow-lg p-8 flex items-center justify-center">
                {product.image_url ? (
                    <img 
                        src={product.image_url} 
                        alt={product.name}
                        class="max-w-full max-h-96 object-contain"
                    />
                ) : (
                    <div class="text-9xl">📦</div>
                )}
            </div>

            <!-- Info -->
            <div>
                <span class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-semibold ${positionInfo.bgColor} ${positionInfo.color} mb-4`}>
                    <span>{positionInfo.emoji}</span>
                    <span>{positionInfo.label}</span>
                </span>
                
                <h1 class="text-3xl font-bold text-gray-900 mb-4">
                    {product.name}
                </h1>

                {product.brand && (
                    <a href={`/categories/${product.category?.slug}/${product.brand.slug}`} class="text-primary-600 hover:text-primary-700 font-medium mb-4 inline-block">
                        {product.brand.name}
                    </a>
                )}

                <p class="text-gray-600 text-lg mb-6">
                    {product.summary}
                </p>

                {product.verdict && (
                    <div class="bg-green-50 border border-green-200 rounded-xl p-4 mb-6">
                        <div class="flex items-start gap-2">
                            <span class="text-xl">💡</span>
                            <div>
                                <span class="font-semibold text-green-800">Notre verdict :</span>
                                <p class="text-green-700">{product.verdict}</p>
                            </div>
                        </div>
                    </div>
                )}

                <!-- Ratings Grid -->
                <div class="bg-gray-50 rounded-xl p-6 mb-6">
                    <h3 class="font-bold text-lg mb-4">Nos évaluations</h3>
                    <div class="grid grid-cols-2 gap-4">
                        {product.rating_quality && (
                            <div class="flex items-center justify-between">
                                <span class="text-gray-600">⭐ Qualité</span>
                                <div class="flex items-center">
                                    <div class="w-24 bg-gray-200 rounded-full h-2 mr-2">
                                        <div class="bg-yellow-400 h-2 rounded-full" style={`width: ${parseFloat(product.rating_quality as any) * 20}%`}></div>
                                    </div>
                                    <span class="font-medium">{product.rating_quality}/5</span>
                                </div>
                            </div>
                        )}
                        {product.rating_price && (
                            <div class="flex items-center justify-between">
                                <span class="text-gray-600">💸 Prix</span>
                                <div class="flex items-center">
                                    <div class="w-24 bg-gray-200 rounded-full h-2 mr-2">
                                        <div class="bg-green-400 h-2 rounded-full" style={`width: ${parseFloat(product.rating_price as any) * 20}%`}></div>
                                    </div>
                                    <span class="font-medium">{product.rating_price}/5</span>
                                </div>
                            </div>
                        )}
                        {product.rating_durability && (
                            <div class="flex items-center justify-between">
                                <span class="text-gray-600">🔧 Durabilité</span>
                                <div class="flex items-center">
                                    <div class="w-24 bg-gray-200 rounded-full h-2 mr-2">
                                        <div class="bg-blue-400 h-2 rounded-full" style={`width: ${parseFloat(product.rating_durability as any) * 20}%`}></div>
                                    </div>
                                    <span class="font-medium">{product.rating_durability}/5</span>
                                </div>
                            </div>
                        )}
                        {product.rating_reliability && (
                            <div class="flex items-center justify-between">
                                <span class="text-gray-600">✅ Fiabilité</span>
                                <div class="flex items-center">
                                    <div class="w-24 bg-gray-200 rounded-full h-2 mr-2">
                                        <div class="bg-purple-400 h-2 rounded-full" style={`width: ${parseFloat(product.rating_reliability as any) * 20}%`}></div>
                                    </div>
                                    <span class="font-medium">{product.rating_reliability}/5</span>
                                </div>
                            </div>
                        )}
                    </div>
                </div>

                <!-- Recommandations -->
                {(product.recommended_for?.length > 0 || product.not_recommended_for?.length > 0) && (
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                        {product.recommended_for?.length > 0 && (
                            <div class="bg-green-50 rounded-xl p-4">
                                <h4 class="font-semibold text-green-800 mb-2">✅ Recommandé pour</h4>
                                <ul class="text-green-700 text-sm space-y-1">
                                    {product.recommended_for.map((item: string) => (
                                        <li>• {item}</li>
                                    ))}
                                </ul>
                            </div>
                        )}
                        {product.not_recommended_for?.length > 0 && (
                            <div class="bg-red-50 rounded-xl p-4">
                                <h4 class="font-semibold text-red-800 mb-2">❌ Pas idéal pour</h4>
                                <ul class="text-red-700 text-sm space-y-1">
                                    {product.not_recommended_for.map((item: string) => (
                                        <li>• {item}</li>
                                    ))}
                                </ul>
                            </div>
                        )}
                    </div>
                )}

                <!-- Price and CTA -->
                <div class="flex items-center justify-between p-6 bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200 rounded-xl mb-4">
                    <div>
                        <span class="text-sm text-gray-600">Prix constaté</span>
                        <div class="text-3xl font-bold text-gray-900">
                            {product.price_display || 'Voir le prix'}
                        </div>
                    </div>
                    <a 
                        href={product.amazon_url} 
                        target="_blank" 
                        rel="noopener sponsored"
                        class="inline-flex items-center gap-2 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white px-8 py-4 rounded-xl font-bold text-lg transition-all shadow-lg hover:shadow-xl"
                    >
                        🛒 Voir sur Amazon
                    </a>
                </div>

                <!-- Bouton Comparateur -->
                <div class="flex items-center gap-3">
                    <AddToCompare productId={product.id} productName={product.name} variant="button" />
                    <a href="/comparateur" class="text-sm text-gray-500 hover:text-blue-600 transition-colors">
                        Voir le comparateur →
                    </a>
                </div>
            </div>
        </div>

        <!-- Related Products -->
        {relatedProducts.length > 0 && (
            <section class="mt-16">
                <h2 class="text-2xl font-bold text-gray-900 mb-6">
                    Autres produits {product.brand?.name}
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    {relatedProducts.map((p) => (
                        <DbProductCard product={p} showBrand={true} />
                    ))}
                </div>
            </section>
        )}

        <!-- SEO Content -->
        <section class="mt-16 bg-white rounded-2xl shadow-lg p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">À propos du {product.name}</h2>
            <p class="text-gray-600 mb-6">{product.summary}</p>
            {product.brand && (
                <>
                    <h3 class="text-xl font-bold text-gray-900 mb-2">Pourquoi choisir {product.brand.name} ?</h3>
                    <p class="text-gray-600">{product.brand.description || `${product.brand.name} est une marque reconnue pour la qualité de ses produits.`}</p>
                </>
            )}
        </section>
    </div>
</Layout>
