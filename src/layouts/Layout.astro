---
// Poids explicitement listés à la section 3 (Typographie) du design-system,
// rien de plus pour ne pas alourdir le payload.
import '@fontsource/big-shoulders-display/700';
import '@fontsource/big-shoulders-display/800';
import '@fontsource/public-sans/400';
import '@fontsource/public-sans/500';
import '@fontsource/public-sans/600';
import '@fontsource/ibm-plex-mono/400';
import '@fontsource/ibm-plex-mono/500';
import '../styles/global.css';
import { SITE_URL } from '../lib/site';
import ReglGraduee from '../components/ReglGraduee.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalPath?: string;
}
const {
  title,
  description = "Trouve-Tout : guides d'achat outillage et jardin — on vous aide à choisir, pas à acheter.",
  ogImage = '/og-default.png',
  canonicalPath,
} = Astro.props;

const siteUrl = SITE_URL;
// On normalise le chemin : pas de slash final parasite, pas de query string
// (sinon Google voit autant de "pages" que de variantes d'URL).
const rawPath = canonicalPath ?? Astro.url.pathname;
const cleanPath = rawPath !== '/' ? rawPath.replace(/\/+$/, '') : '/';
const canonical = `${siteUrl}${cleanPath}`;
const fullTitle = `${title} — Trouve-Tout`;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:site_name" content="Trouve-Tout" />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- Schema.org WebSite -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Trouve-Tout',
      url: siteUrl,
      description: "Guides d'achat outillage honnêtes — on vous aide à choisir, pas à acheter.",
    })} />
  </head>
  <body class="bg-atelier text-graphite font-lecture text-lecture antialiased min-h-screen flex flex-col">
    <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-securite focus:text-graphite focus:px-4 focus:py-2">
      Aller au contenu
    </a>

    <header class="border-b border-graphite">
      <nav class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center gap-6">
        <a href="/" class="font-display text-display-m text-graphite tracking-tight">TROUVE-TOUT</a>
        <div class="hidden sm:flex items-center gap-6 font-mono text-kicker uppercase text-graphite">
          <a href="/categories" class="hover:text-cordeau transition-colors">Catégories</a>
          <a href="/blog" class="hover:text-cordeau transition-colors">Guides</a>
          <a href="/marques" class="hover:text-cordeau transition-colors">Marques</a>
        </div>
        <a
          href="/choix-express"
          class="ml-auto border border-cordeau text-cordeau font-mono text-kicker uppercase px-4 py-2 hover:bg-cordeau-light transition-colors"
        >
          Choix Express
        </a>
      </nav>
    </header>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 flex-1 w-full flex gap-4 sm:gap-6">
      <ReglGraduee />
      <main id="contenu" class="flex-1 min-w-0 py-8">
        <slot />
      </main>
    </div>

    <footer class="mt-16 border-t border-graphite py-8 px-4">
      <div class="max-w-6xl mx-auto space-y-4 font-mono text-mono-base text-ligne">
        <div class="flex flex-col sm:flex-row justify-between gap-4">
          <div>© {new Date().getFullYear()} Trouve-Tout · Guides d'achat outillage indépendants</div>
          <div class="flex flex-wrap gap-4">
            <a href="/categories" class="hover:text-cordeau transition-colors">Catégories</a>
            <a href="/blog" class="hover:text-cordeau transition-colors">Guides</a>
            <a href="/mentions-legales" class="hover:text-cordeau transition-colors">Mentions légales</a>
            <a href="/confidentialite" class="hover:text-cordeau transition-colors">Confidentialité</a>
            <a href="/sitemap.xml" class="hover:text-cordeau transition-colors">Sitemap</a>
          </div>
        </div>
        <div class="pt-4 border-t border-ligne/40 font-lecture text-legende leading-relaxed">
          <p>
            Certains liens de ce site sont des liens d'affiliation : si vous achetez après avoir
            cliqué, nous percevons une commission du marchand. <strong class="text-graphite">Le prix que vous payez est
            strictement identique.</strong> Cela ne change ni nos recommandations ni l'ordre des
            produits présentés.
          </p>
          <p class="mt-2">
            En tant que Partenaire Amazon, nous réalisons un bénéfice sur les achats remplissant
            les conditions requises.
          </p>
          <p class="mt-2">
            Les fourchettes de prix sont indicatives et peuvent varier. Seul le prix affiché sur
            le site du marchand fait foi.
          </p>
        </div>
      </div>
    </footer>

    <!-- Vercel Web Analytics (à activer dans Vercel > Analytics) -->
    <script defer src="/_vercel/insights/script.js"></script>

    <!-- Tracking des clics affiliés : sans ce compteur, impossible de savoir
         si le problème vient du trafic ou du contenu. -->
    <script is:inline>
      document.addEventListener('click', (e) => {
        const a = e.target.closest('a[data-affilie]');
        if (!a) return;
        const payload = {
          marchand: a.dataset.affilie,
          page: location.pathname,
        };
        if (window.va) window.va('event', { name: 'clic_affilie', data: payload });
      });
    </script>
  </body>
</html>
