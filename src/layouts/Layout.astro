---
// Poids explicitement listés à la section 3 (Typographie) du design-system,
// rien de plus pour ne pas alourdir le payload.
import '@fontsource/manrope/700';
import '@fontsource/manrope/800';
import '@fontsource/public-sans/400';
import '@fontsource/public-sans/500';
import '@fontsource/public-sans/700';
import '@fontsource/ibm-plex-mono/500';
import '@fontsource/ibm-plex-mono/600';
import '@fontsource/big-shoulders-display/700';
import '@fontsource/big-shoulders-display/800';
import '../styles/global.css';
import { SITE_URL } from '../lib/site';
import { GOOGLE_ADSENSE_CLIENT_ID, publiciteConfiguree } from '../lib/publicite';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalPath?: string;
  /** L'accueil porte son propre header (coque translucide) — voir design-system.md. */
  hideHeader?: boolean;
  /** true pour une fiche encore verifie:false : indexable en direct mais pas promue par Google. */
  noindex?: boolean;
}
const {
  title,
  description = "Trouve-Tout : guides d'achat outillage et jardin — on vous aide à choisir, pas à acheter.",
  ogImage = '/og-default.png',
  canonicalPath,
  hideHeader = false,
  noindex = false,
} = Astro.props;

const siteUrl = SITE_URL;
// On normalise le chemin : pas de slash final parasite, pas de query string
// (sinon Google voit autant de "pages" que de variantes d'URL).
const rawPath = canonicalPath ?? Astro.url.pathname;
const cleanPath = rawPath !== '/' ? rawPath.replace(/\/+$/, '') : '/';
const canonical = `${siteUrl}${cleanPath}`;
const fullTitle = `${title} — Trouve-Tout`;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Photos produit servies par ce CDN sur quasi toutes les pages (voir
         src/lib/image.ts) : preconnect raccourcit le TTFB de l'image LCP. -->
    <link rel="preconnect" href="https://images2.productserve.com" crossorigin />
    <link rel="dns-prefetch" href="https://images2.productserve.com" />

    <!-- Debug images cassées (diagnostic temporaire) : le cache Varnish
         d'Awin sert parfois un fallback "noimage" périmé jusqu'à 31 jours
         après la disparition du fichier source côté ManoMano, de façon
         instable d'une requête à l'autre. Ce fallback arrive en 302 vers
         /noimage.gif, qui se charge ensuite avec succès (200) : du point
         de vue du <img>, c'est un chargement normal, aucun 'error' ne se
         déclenche. Le listener 'error' seul ne voit donc que les échecs
         réseau francs (bloqué, timeout, 404 sans redirection) — on
         re-fetch chaque image chargée pour lire l'URL finale après
         redirection et repérer le cas noimage.gif, qui est le plus
         fréquent ici. Coût volontairement ignoré (double requête, servie
         par le cache HTTP) puisque c'est temporaire.
         Log console + événement Vercel Analytics dans les deux cas, pour
         repérer en prod quelles fiches restent cassées sans devoir rouvrir
         les devtools sur chaque page. À retirer une fois le problème
         résolu. Placé dans <head> (pas en fin de body) : les images eager
         peuvent charger/échouer avant que le parseur n'atteigne le bas de
         la page, et ni 'error' ni 'load' sur <img> ne bubble — la capture
         doit être posée avant le premier chargement possible. -->
    <script is:inline>
      function signalerImageCassee(img, raison) {
        const box = img.closest('[data-img-box]');
        if (!box) return;
        const payload = { url: img.currentSrc || img.src, alt: img.alt, page: location.pathname, raison };
        console.warn('[TT-IMG] image cassée', payload);
        if (window.va) window.va('event', { name: 'image_cassee', data: payload });
        box.style.display = 'none';
      }

      window.addEventListener('error', (e) => {
        const img = e.target;
        if (!img || img.tagName !== 'IMG' || !img.closest('[data-img-box]')) return;
        signalerImageCassee(img, 'erreur-reseau');
      }, true);

      window.addEventListener('load', (e) => {
        const img = e.target;
        if (!img || img.tagName !== 'IMG' || !img.closest('[data-img-box]')) return;
        const src = img.currentSrc || img.src;
        if (!src) return;
        fetch(src, { cache: 'force-cache' })
          .then((r) => {
            if (r.url.includes('/noimage.gif')) signalerImageCassee(img, 'fallback-noimage');
          })
          .catch(() => {});
      }, true);
    </script>

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:site_name" content="Trouve-Tout" />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- Schema.org WebSite -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Trouve-Tout',
      url: siteUrl,
      description: "Guides d'achat outillage honnêtes — on vous aide à choisir, pas à acheter.",
    })} />

    <!-- Schema.org Organization — pas de SearchAction : le site n'a pas de
         recherche interne, en ajouter un serait un balisage inexact. -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Trouve-Tout',
      url: siteUrl,
      logo: `${siteUrl}/favicon.svg`,
      description: "Guides d'achat outillage honnêtes — on vous aide à choisir, pas à acheter.",
    })} />

    {publiciteConfiguree && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${GOOGLE_ADSENSE_CLIENT_ID}`}
        crossorigin="anonymous"
      />
    )}
  </head>
  <body class="bg-bg text-ink font-body text-body antialiased min-h-screen flex flex-col">
    <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-signal focus:text-ink focus:px-4 focus:py-2 focus:rounded">
      Aller au contenu
    </a>

    {!hideHeader && (
      <header class="border-b border-line/40">
        <nav class="max-w-[1600px] mx-auto px-4 sm:px-6 py-4 flex items-center gap-6">
          <a href="/" aria-label="Trouve-Tout — accueil"><Logo size={30} /></a>
          <div class="hidden sm:flex items-center gap-6 font-mono text-label uppercase text-ink">
            <a href="/categories" class="hover:text-accent transition-colors">Catégories</a>
            <a href="/blog" class="hover:text-accent transition-colors">Guides</a>
            <a href="/marques" class="hover:text-accent transition-colors">Marques</a>
          </div>
          <a
            href="/choix-express"
            class="ml-auto rounded border border-accent text-accent font-mono text-label uppercase px-4 py-2 hover:bg-accent/10 transition-colors"
          >
            Choix Express
          </a>
          <details class="relative sm:hidden">
            <summary
              class="grid h-9 w-9 place-items-center rounded border border-line/60 list-none cursor-pointer [&::-webkit-details-marker]:hidden"
              aria-label="Ouvrir le menu"
            >
              <svg width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true">
                <path d="M0 1h18M0 7h18M0 13h18" stroke="currentColor" stroke-width="2" />
              </svg>
            </summary>
            <div class="absolute right-0 top-full z-10 mt-2 w-48 flex flex-col rounded border border-line/40 bg-bg p-2 shadow-tile font-mono text-label uppercase text-ink">
              <a href="/categories" class="rounded px-3 py-2.5 hover:bg-surface hover:text-accent transition-colors">Catégories</a>
              <a href="/blog" class="rounded px-3 py-2.5 hover:bg-surface hover:text-accent transition-colors">Guides</a>
              <a href="/marques" class="rounded px-3 py-2.5 hover:bg-surface hover:text-accent transition-colors">Marques</a>
            </div>
          </details>
        </nav>
      </header>
    )}

    <main id="contenu" class="max-w-[1600px] mx-auto px-4 sm:px-6 flex-1 w-full py-8">
      <slot />
    </main>

    <footer class="mt-16 border-t border-line/40 py-8 px-4">
      <div class="max-w-[1600px] mx-auto space-y-4 font-mono text-data text-ink">
        <div class="flex flex-col sm:flex-row justify-between gap-4">
          <div>© {new Date().getFullYear()} Trouve-Tout · Guides d'achat outillage indépendants</div>
          <div class="flex flex-wrap gap-4">
            <a href="/categories" class="hover:text-accent transition-colors">Catégories</a>
            <a href="/blog" class="hover:text-accent transition-colors">Guides</a>
            <a href="/marques" class="hover:text-accent transition-colors">Marques</a>
            <a href="/produits" class="hover:text-accent transition-colors">Tous les produits</a>
            <a href="/mentions-legales" class="hover:text-accent transition-colors">Mentions légales</a>
            <a href="/confidentialite" class="hover:text-accent transition-colors">Confidentialité</a>
            <a href="/sitemap.xml" class="hover:text-accent transition-colors">Sitemap</a>
          </div>
        </div>
        <div class="pt-4 border-t border-line/40 font-body text-small leading-relaxed">
          <p>
            Certains liens de ce site sont des liens d'affiliation : si vous achetez après avoir
            cliqué, nous percevons une commission du marchand. <strong class="text-ink">Le prix que vous payez est
            strictement identique.</strong> Cela ne change ni nos recommandations ni l'ordre des
            produits présentés.
          </p>
          <p class="mt-2">
            En tant que Partenaire Amazon, nous réalisons un bénéfice sur les achats remplissant
            les conditions requises.
          </p>
          <p class="mt-2">
            Les prix affichés sont ceux constatés chez le marchand au moment de la rédaction et
            peuvent avoir changé depuis. Seul le prix affiché sur le site du marchand fait foi.
          </p>
        </div>
      </div>
    </footer>

    <!-- Vercel Web Analytics (à activer dans Vercel > Analytics) -->
    <script defer src="/_vercel/insights/script.js"></script>

    <!-- Tracking des clics affiliés : sans ce compteur, impossible de savoir
         si le problème vient du trafic ou du contenu. -->
    <script is:inline>
      document.addEventListener('click', (e) => {
        const a = e.target.closest('a[data-affilie]');
        if (!a) return;
        const payload = {
          marchand: a.dataset.affilie,
          page: location.pathname,
        };
        if (window.va) window.va('event', { name: 'clic_affilie', data: payload });
      });
    </script>
  </body>
</html>
