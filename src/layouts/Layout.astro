---
import { SITE_URL } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalPath?: string;
}
const {
  title,
  description = 'Trouve le meilleur produit sans perdre de temps — comparatifs honnêtes, verdict clair.',
  ogImage = '/og-default.png',
  canonicalPath,
} = Astro.props;

const siteUrl = SITE_URL;
// On normalise le chemin : pas de slash final parasite, pas de query string
// (sinon Google voit autant de "pages" que de variantes d'URL).
const rawPath = canonicalPath ?? Astro.url.pathname;
const cleanPath = rawPath !== '/' ? rawPath.replace(/\/+$/, '') : '/';
const canonical = `${siteUrl}${cleanPath}`;
const fullTitle = `${title} — Trouve-Tout`;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:site_name" content="Trouve-Tout" />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- Schema.org WebSite -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Trouve-Tout',
      url: siteUrl,
      description: 'Comparatif produits honnête — verdict clair en 30 secondes.',
    })} />
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen">
    <nav class="bg-white border-b border-gray-200 px-4 py-3 flex items-center gap-6 text-sm font-medium">
      <a href="/" class="text-lg font-bold text-indigo-600">Trouve-Tout</a>
      <a href="/categories" class="hover:text-indigo-600">Catégories</a>
      <a href="/choix-express" class="hover:text-indigo-600">Choix Express</a>
      <a href="/blog" class="hover:text-indigo-600">Guides</a>
      <a href="/profil" class="ml-auto hover:text-indigo-600">Mon profil</a>
    </nav>
    <main>
      <slot />
    </main>
    <footer class="mt-16 border-t border-gray-200 py-8 px-4">
      <div class="max-w-5xl mx-auto space-y-4 text-xs text-gray-500">
        <div class="flex flex-col sm:flex-row justify-between gap-4">
          <div>© {new Date().getFullYear()} Trouve-Tout · Guides d'achat outillage indépendants</div>
          <div class="flex flex-wrap gap-4">
            <a href="/categories" class="hover:text-gray-700">Catégories</a>
            <a href="/blog" class="hover:text-gray-700">Guides</a>
            <a href="/mentions-legales" class="hover:text-gray-700">Mentions légales</a>
            <a href="/confidentialite" class="hover:text-gray-700">Confidentialité</a>
            <a href="/sitemap.xml" class="hover:text-gray-700">Sitemap</a>
          </div>
        </div>
        <div class="pt-4 border-t border-gray-100 text-gray-400 leading-relaxed">
          <p>
            Certains liens de ce site sont des liens d'affiliation : si tu achètes après avoir
            cliqué, nous percevons une commission du marchand. <strong>Le prix que tu paies est
            strictement identique.</strong> Cela ne change ni nos recommandations ni l'ordre des
            produits présentés.
          </p>
          <p class="mt-2">
            En tant que Partenaire Amazon, nous réalisons un bénéfice sur les achats remplissant
            les conditions requises.
          </p>
          <p class="mt-2">
            Les fourchettes de prix sont indicatives et peuvent varier. Seul le prix affiché sur
            le site du marchand fait foi.
          </p>
        </div>
      </div>
    </footer>
    <!-- Vercel Web Analytics (a activer dans Vercel > Analytics) -->
    <script defer src="/_vercel/insights/script.js"></script>

    <!-- Tracking des clics affilies : sans ce compteur, impossible de savoir
         si le probleme vient du trafic ou du contenu. -->
    <script is:inline>
      document.addEventListener('click', (e) => {
        const a = e.target.closest('a[data-affilie]');
        if (!a) return;
        const payload = {
          marchand: a.dataset.affilie,
          page: location.pathname,
        };
        if (window.va) window.va('event', { name: 'clic_affilie', data: payload });
      });
    </script>
  </body>
</html>
