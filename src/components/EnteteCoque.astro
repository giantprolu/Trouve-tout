---
/**
 * En-tête inséré dans la coque translucide (design importé de Trouve-Tout
 * Pages.dc.html / Trouve-Tout Accueil.dc.html) : logo, accès aux guides,
 * nav catégories. Utilisé sur toutes les pages qui portent la coque
 * (elles passent `hideHeader` à Layout et rendent cet en-tête elles-mêmes).
 */
import { categories } from '../lib/data';
import Logo from './Logo.astro';
---
<div class="flex flex-wrap items-center gap-3 mb-4">
  <a href="/" class="flex items-center rounded-full bg-white/95 shadow-tile px-5 py-2.5" aria-label="Trouve-Tout — accueil">
    <Logo size={26} />
  </a>
  <a
    href="/categories"
    class="flex-1 min-w-[200px] flex items-center justify-between gap-3 rounded-full bg-white/95 shadow-tile pl-6 pr-1.5 py-1.5 hover:bg-white transition-colors"
  >
    <span class="text-body text-ink/55">Parcourir tous les guides</span>
    <span class="grid h-[42px] w-[42px] flex-none place-items-center rounded-full bg-ink text-bg" aria-hidden="true">→</span>
  </a>
  <div class="flex items-center gap-6 px-3 font-display font-semibold text-body">
    {categories.map((c) => (
      <a href={`/categories/${c.slug}`} class="text-ink hover:text-accent transition-colors whitespace-nowrap">
        {c.nom}
      </a>
    ))}
  </div>
</div>
