---
import type { Product } from '../types/db';
import { formatPrice, getRatingStars, getTierLabel } from '../data/products';

interface Props {
    product: Product;
    showTier?: boolean;
}

const { product, showTier = true } = Astro.props;
const tierInfo = product.tier ? getTierLabel(product.tier) : null;
---

<article class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300 flex flex-col">
    <!-- Image -->
    <div class="relative h-48 bg-gray-100 flex items-center justify-center">
        {product.image_url ? (
            <img 
                src={product.image_url} 
                alt={product.name}
                class="w-full h-full object-cover"
                loading="lazy"
            />
        ) : (
            <div class="text-6xl">📦</div>
        )}
        {showTier && tierInfo && (
            <span class={`absolute top-2 right-2 ${tierInfo.color} text-white text-xs px-2 py-1 rounded-full font-medium`}>
                {tierInfo.label}
            </span>
        )}
    </div>

    <!-- Content -->
    <div class="p-4 flex flex-col flex-grow">
        <div class="flex items-start justify-between mb-2">
            <h3 class="font-bold text-lg text-gray-900 line-clamp-2">{product.name}</h3>
        </div>
        
        <p class="text-gray-600 text-sm mb-3 line-clamp-2 flex-grow">
            {product.description}
        </p>

        <!-- Ratings -->
        <div class="grid grid-cols-2 gap-2 text-xs mb-4">
            {product.quality_rating && (
                <div class="flex items-center gap-1" title="Qualité">
                    <span>⭐</span>
                    <span class="text-gray-600">Qualité: {product.quality_rating}/5</span>
                </div>
            )}
            {product.price_rating && (
                <div class="flex items-center gap-1" title="Rapport Prix">
                    <span>💸</span>
                    <span class="text-gray-600">Prix: {product.price_rating}/5</span>
                </div>
            )}
            {product.durability_rating && (
                <div class="flex items-center gap-1" title="Durabilité">
                    <span>🔧</span>
                    <span class="text-gray-600">Durabilité: {product.durability_rating}/5</span>
                </div>
            )}
            {product.service_rating && (
                <div class="flex items-center gap-1" title="SAV">
                    <span>🛠</span>
                    <span class="text-gray-600">SAV: {product.service_rating}/5</span>
                </div>
            )}
        </div>

        <!-- Price and CTA -->
        <div class="flex items-center justify-between mt-auto pt-3 border-t">
            <span class="text-2xl font-bold text-primary-600">
                {product.price ? formatPrice(product.price) : 'Prix sur demande'}
            </span>
            <a 
                href={`/produits/${product.id}`}
                class="bg-primary-600 hover:bg-primary-700 text-white px-4 py-2 rounded-lg font-medium transition-colors text-sm"
            >
                Voir détails
            </a>
        </div>
    </div>
</article>
