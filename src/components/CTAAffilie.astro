---
import { lienAffilie, nomMarchand, type Marchand } from '../lib/affiliation';

interface Props {
  url: string;
  marchand: Marchand;
  label?: string;
  variant?: 'primary' | 'small';
}
const { url, marchand, label, variant = 'primary' } = Astro.props;

const href = lienAffilie(marchand, url);
const texte = label ?? `Voir le prix chez ${nomMarchand[marchand]}`;

// rel="sponsored" est la valeur attendue par Google pour un lien commercial.
const rel = 'sponsored nofollow noopener noreferrer';
---
{variant === 'primary' ? (
  <div>
    <a
      href={href}
      target="_blank"
      rel={rel}
      data-affilie={marchand}
      class="inline-flex flex-col items-start gap-1 rounded bg-signal px-6 py-3 text-ink transition-[filter] hover:brightness-[0.92] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    >
      <span class="font-mono text-label uppercase">Chez {nomMarchand[marchand]}</span>
      <span class="font-body text-body font-bold">{texte} <span aria-hidden="true">→</span></span>
    </a>
    <p class="mt-2 text-small text-ink">Lien affilié — le prix est le même pour vous.</p>
  </div>
) : (
  <a
    href={href}
    target="_blank"
    rel={rel}
    data-affilie={marchand}
    class="text-accent hover:text-ink text-small font-medium underline underline-offset-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
  >
    {texte} <span aria-hidden="true">→</span>
  </a>
)}
