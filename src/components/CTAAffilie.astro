---
import { lienAffilie, nomMarchand, type Marchand } from '../lib/affiliation';

interface Props {
  url: string;
  marchand: Marchand;
  label?: string;
  variant?: 'primary' | 'small';
}
const { url, marchand, label, variant = 'primary' } = Astro.props;

const href = lienAffilie(marchand, url);
const texte = label ?? `Voir sur ${nomMarchand[marchand]}`;

// rel="sponsored" est la valeur attendue par Google pour un lien commercial.
const rel = 'sponsored nofollow noopener noreferrer';
---
{variant === 'primary' ? (
  <a
    href={href}
    target="_blank"
    rel={rel}
    data-affilie={marchand}
    class="inline-flex items-center gap-2 bg-amber-400 hover:bg-amber-500 text-gray-900 font-semibold px-5 py-3 rounded-xl transition text-sm"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
    </svg>
    {texte}
  </a>
) : (
  <a
    href={href}
    target="_blank"
    rel={rel}
    data-affilie={marchand}
    class="text-amber-600 hover:text-amber-700 text-sm font-medium underline underline-offset-2"
  >
    {texte} ↗
  </a>
)}
