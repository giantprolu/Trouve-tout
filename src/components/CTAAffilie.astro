---
import { lienAffilie, nomMarchand, type Marchand } from '../lib/affiliation';

interface Props {
  url: string;
  marchand: Marchand;
  label?: string;
  variant?: 'primary' | 'small';
}
const { url, marchand, label, variant = 'primary' } = Astro.props;

const href = lienAffilie(marchand, url);
const texte = label ?? `Voir le prix chez ${nomMarchand[marchand]} ↗`;

// rel="sponsored" est la valeur attendue par Google pour un lien commercial.
const rel = 'sponsored nofollow noopener noreferrer';
---
{variant === 'primary' ? (
  <div>
    <a
      href={href}
      target="_blank"
      rel={rel}
      data-affilie={marchand}
      class="inline-flex items-center gap-2 bg-securite hover:bg-securite-dark text-graphite border border-graphite px-6 py-3 font-lecture text-lecture font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cordeau"
    >
      {texte}
    </a>
    <p class="mt-2 text-legende text-graphite">Lien affilié — le prix est le même pour vous.</p>
  </div>
) : (
  <a
    href={href}
    target="_blank"
    rel={rel}
    data-affilie={marchand}
    class="text-cordeau hover:text-graphite text-legende font-medium underline underline-offset-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cordeau"
  >
    {texte}
  </a>
)}
