---
import type { Produit } from '../lib/data';
import { niveauConfiance, SEGMENT_LABEL } from '../lib/data';
import { prixAffichage, imageActuelle } from '../lib/affiliation';
import { imageTaille } from '../lib/image';
import CTAAffilie from './CTAAffilie.astro';

interface Props {
  produits: Produit[];
}
const { produits } = Astro.props;

// Le produit recommandé est celui à la plus haute confiance éditoriale du
// lot — sa ligne est mise en avant par le fond, pas par un badge doré.
const slugRecommande = produits.reduce((meilleur, p) =>
  niveauConfiance(p) > niveauConfiance(meilleur) ? p : meilleur
, produits[0])?.slug;
---
<div class="tableau-comparatif">
  <!-- Mobile (< sm) : liste de cartes empilées, aucun scroll horizontal requis. -->
  <ul class="flex flex-col divide-y divide-line/30 shadow-card rounded sm:hidden">
    {produits.map((p, i) => {
      const estRecommande = p.slug === slugRecommande;
      const fond = estRecommande ? 'bg-surface' : i % 2 === 0 ? 'bg-bg' : 'bg-surface';
      const image = imageActuelle(p);
      return (
        <li class={`${fond} ${estRecommande ? 'border-l-2 border-accent' : ''}`}>
          <a href={`/produits/${p.slug}`} class="flex items-center gap-3 px-3 py-3">
            {image && (
              <span data-img-box class="block h-14 w-14 flex-none rounded bg-white overflow-hidden">
                <img src={imageTaille(image, 120)} width="56" height="56" alt={p.nom} loading="lazy" decoding="async" class="h-full w-full object-contain" onload="window.signalerImageFallbackSiNoimage(this)" />
              </span>
            )}
            <span class="min-w-0 flex-1">
              <span class="block font-body font-semibold text-ink truncate">{p.nom}</span>
              <span class="mt-1.5 flex items-center gap-2">
                <span class="rounded-full bg-bg px-2.5 py-0.5 font-mono text-label uppercase text-ink/70">
                  {SEGMENT_LABEL[p.segment]}
                </span>
                <span class="font-mono text-data text-ink whitespace-nowrap">{prixAffichage(p)}</span>
              </span>
            </span>
            <span class="flex-none font-mono text-label uppercase text-accent">Voir→</span>
          </a>
        </li>
      );
    })}
  </ul>

  <!-- Desktop / tablette (sm+) : tableau, colonnes toujours visibles avec un rappel visuel si ça déborde encore. -->
  <div class="relative hidden sm:block">
    <div class="tableau-comparatif-scroll overflow-x-auto shadow-card rounded">
      <table class="w-full text-body">
        <thead>
          <tr class="border-b border-line/40">
            <th scope="col" class="px-3 py-3"><span class="sr-only">Photo</span></th>
            <th scope="col" class="text-left px-4 py-3 font-display text-display-m lowercase text-ink">produit</th>
            <th scope="col" class="text-right px-3 py-3 font-display text-display-m lowercase text-ink">budget</th>
            <th scope="col" class="text-right px-3 py-3 font-display text-display-m lowercase text-ink">segment</th>
            <th scope="col" class="px-3 py-3"><span class="sr-only">Lien marchand</span></th>
          </tr>
        </thead>
        <tbody>
          {produits.map((p, i) => {
            const estRecommande = p.slug === slugRecommande;
            const fond = estRecommande ? 'bg-surface' : i % 2 === 0 ? 'bg-bg' : 'bg-surface';
            const image = imageActuelle(p);
            return (
              <tr class={`${fond} ${estRecommande ? 'border-l-2 border-accent' : ''} hover:bg-card transition-colors`}>
                <td class="px-3 py-4">
                  {image && (
                    <a href={`/produits/${p.slug}`} data-img-box class="block h-12 w-12 rounded bg-white overflow-hidden">
                      <img src={imageTaille(image, 120)} width="48" height="48" alt={p.nom} loading="lazy" decoding="async" class="h-full w-full object-contain" onload="window.signalerImageFallbackSiNoimage(this)" />
                    </a>
                  )}
                </td>
                <td class="px-4 py-4">
                  <a href={`/produits/${p.slug}`} class="font-body font-semibold text-ink hover:text-accent transition-colors">
                    {p.nom}
                  </a>
                </td>
                <td class="text-right px-3 py-4 font-mono text-data text-ink whitespace-nowrap">
                  {prixAffichage(p)}
                </td>
                <td class="text-right px-3 py-4">
                  <span class="inline-block rounded-full bg-bg px-2.5 py-0.5 font-mono text-label uppercase text-ink/70 whitespace-nowrap">
                    {SEGMENT_LABEL[p.segment]}
                  </span>
                </td>
                <td class="px-3 py-4 text-center">
                  <CTAAffilie url={p.urlMarchand} marchand={p.marchand} variant="small" label="Voir" />
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <div class="tableau-comparatif-fade pointer-events-none absolute right-0 top-0 h-full w-8 rounded-r bg-gradient-to-l from-bg to-transparent opacity-0 transition-opacity" aria-hidden="true"></div>
  </div>
</div>

<script is:inline>
  // Degrade visuel a droite du tableau tant qu'il reste du contenu a scroller
  // horizontalement (mobile surtout) — sans lui, rien ne signale que la colonne
  // segment/budget est coupee.
  document.querySelectorAll('.tableau-comparatif').forEach((wrap) => {
    const scrollEl = wrap.querySelector('.tableau-comparatif-scroll');
    const fade = wrap.querySelector('.tableau-comparatif-fade');
    if (!scrollEl || !fade) return;
    const maj = () => {
      const resteAScroller = scrollEl.scrollWidth - scrollEl.scrollLeft - scrollEl.clientWidth > 4;
      fade.style.opacity = resteAScroller ? '1' : '0';
    };
    scrollEl.addEventListener('scroll', maj, { passive: true });
    window.addEventListener('resize', maj);
    maj();
  });
</script>
