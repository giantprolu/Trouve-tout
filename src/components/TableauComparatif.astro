---
import type { Produit } from '../lib/data';
import { niveauConfiance, SEGMENT_LABEL } from '../lib/data';
import { formaterPrix } from '../lib/affiliation';
import { imageTaille } from '../lib/image';
import CTAAffilie from './CTAAffilie.astro';

interface Props {
  produits: Produit[];
}
const { produits } = Astro.props;

// Le produit recommandé est celui à la plus haute confiance éditoriale du
// lot — sa ligne est mise en avant par le fond, pas par un badge doré.
const slugRecommande = produits.reduce((meilleur, p) =>
  niveauConfiance(p) > niveauConfiance(meilleur) ? p : meilleur
, produits[0])?.slug;
---
<div class="overflow-x-auto shadow-card rounded">
  <table class="w-full text-body">
    <thead>
      <tr>
        <th scope="col" class="px-3 py-3"><span class="sr-only">Photo</span></th>
        <th scope="col" class="text-left px-4 py-3 font-display text-display-m lowercase text-ink">produit</th>
        <th scope="col" class="text-right px-3 py-3 font-display text-display-m lowercase text-ink">budget</th>
        <th scope="col" class="text-right px-3 py-3 font-display text-display-m lowercase text-ink">segment</th>
        <th scope="col" class="px-3 py-3"><span class="sr-only">Lien marchand</span></th>
      </tr>
    </thead>
    <tbody>
      {produits.map((p, i) => {
        const estRecommande = p.slug === slugRecommande;
        const fond = estRecommande ? 'bg-surface' : i % 2 === 0 ? 'bg-bg' : 'bg-surface';
        return (
          <tr class={`${fond} ${estRecommande ? 'border-l-2 border-accent' : ''}`}>
            <td class="px-3 py-4">
              {p.image && (
                <a href={`/produits/${p.slug}`} class="block h-12 w-12 rounded bg-white overflow-hidden">
                  <img src={imageTaille(p.image, 120)} width="48" height="48" alt="" loading="lazy" decoding="async" class="h-full w-full object-contain" />
                </a>
              )}
            </td>
            <td class="px-4 py-4">
              <a href={`/produits/${p.slug}`} class="font-body font-semibold text-ink hover:text-accent transition-colors">
                {p.nom}
              </a>
            </td>
            <td class="text-right px-3 py-4 font-mono text-data text-ink whitespace-nowrap">
              {formaterPrix(p.prixIndicatif)}
            </td>
            <td class="text-right px-3 py-4 font-mono text-data text-ink">
              {SEGMENT_LABEL[p.segment]}
            </td>
            <td class="px-3 py-4 text-center">
              <CTAAffilie url={p.urlMarchand} marchand={p.marchand} variant="small" label="Voir" />
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
