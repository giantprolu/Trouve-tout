---
import type { Produit } from '../lib/data';
import { niveauConfiance } from '../lib/data';
import { trancheBudget } from '../lib/affiliation';
import CTAAffilie from './CTAAffilie.astro';
import NiveauABulle from './NiveauABulle.astro';

interface Props {
  produits: Produit[];
}
const { produits } = Astro.props;

const segmentLabel: Record<string, string> = {
  meilleur_rapport: 'Premium',
  milieu: 'Équilibre',
  moins_cher: 'Budget',
};
---
<div class="overflow-x-auto shadow-etch">
  <table class="w-full text-lecture">
    <thead>
      <tr class="bg-graphite text-atelier">
        <th scope="col" class="text-left px-4 py-3 font-lecture font-semibold">Produit</th>
        <th scope="col" class="text-center px-3 py-3 font-lecture font-semibold">Budget</th>
        <th scope="col" class="text-center px-3 py-3 font-lecture font-semibold">Adéquation</th>
        <th scope="col" class="text-center px-3 py-3 font-lecture font-semibold">Segment</th>
        <th scope="col" class="px-3 py-3"><span class="sr-only">Lien marchand</span></th>
      </tr>
    </thead>
    <tbody>
      {produits.map((p, i) => (
        <tr class="bg-tole border-b border-ligne">
          <td class="px-4 py-4">
            <a href={`/produits/${p.slug}`} class="font-lecture font-semibold text-graphite hover:text-cordeau transition-colors">
              {p.nom}
            </a>
          </td>
          <td class="text-center px-3 py-4 font-mono text-mono-base text-graphite whitespace-nowrap">
            {trancheBudget(p.prixIndicatif)}
          </td>
          <td class="px-3 py-4">
            <NiveauABulle niveau={niveauConfiance(p)} taille="mini" class="mx-auto" />
          </td>
          <td class="text-center px-3 py-4 font-mono text-mono-base text-graphite">
            {segmentLabel[p.segment]}
          </td>
          <td class="px-3 py-4 text-center">
            <CTAAffilie url={p.urlMarchand} marchand={p.marchand} variant="small" label="Voir ↗" />
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
