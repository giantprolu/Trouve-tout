---
/**
 * Carte produit pour les données provisoires
 * Affiche les produits avec leurs indicateurs et lien Amazon
 */
import type { Product, ProductPosition } from '../data/provisoire/types';
import { positionLabels, getAverageRating } from '../data/provisoire';

interface Props {
    product: Product;
    rank?: number;
}

const { product, rank } = Astro.props;
const position = positionLabels[product.position];
const average = getAverageRating(product.indicateurs);

// Couleurs selon le positionnement
const positionColors: Record<ProductPosition, { bg: string; border: string; text: string }> = {
    'best-value': { bg: 'bg-yellow-50', border: 'border-yellow-400', text: 'text-yellow-700' },
    'middle-ground': { bg: 'bg-purple-50', border: 'border-purple-400', text: 'text-purple-700' },
    'budget': { bg: 'bg-green-50', border: 'border-green-400', text: 'text-green-700' }
};

const colors = positionColors[product.position];
---

<article class={`relative bg-white rounded-2xl shadow-lg overflow-hidden border-2 ${colors.border} hover:shadow-xl transition-all duration-300 flex flex-col`}>
    <!-- Badge position -->
    <div class={`absolute top-4 left-4 z-10 ${colors.bg} ${colors.text} px-3 py-1 rounded-full text-sm font-bold flex items-center gap-1`}>
        <span>{position.emoji}</span>
        <span>{position.label}</span>
    </div>
    
    <!-- Rang si fourni -->
    {rank && (
        <div class="absolute top-4 right-4 z-10 bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center text-xl font-bold shadow-lg">
            #{rank}
        </div>
    )}
    
    <!-- Image placeholder -->
    <div class="relative pt-16 pb-8 px-8 bg-gradient-to-b from-gray-100 to-white">
        <div class="w-48 h-48 mx-auto bg-gray-200 rounded-xl flex items-center justify-center">
            <span class="text-6xl opacity-50">📦</span>
        </div>
    </div>
    
    <!-- Contenu -->
    <div class="p-6 flex-1 flex flex-col">
        <!-- Marque -->
        <p class="text-sm text-indigo-600 font-semibold mb-1">{product.marque}</p>
        
        <!-- Nom -->
        <h3 class="text-lg font-bold text-gray-900 mb-2 line-clamp-2">
            {product.nom}
        </h3>
        
        <!-- Résumé -->
        <p class="text-sm text-gray-600 mb-4 line-clamp-2">
            {product.resume}
        </p>
        
        <!-- Indicateurs -->
        <div class="grid grid-cols-2 gap-2 mb-4">
            <div class="flex items-center gap-2 text-sm">
                <span>⭐</span>
                <span class="text-gray-600">Qualité</span>
                <span class="font-semibold text-gray-900">{product.indicateurs.qualite}/5</span>
            </div>
            <div class="flex items-center gap-2 text-sm">
                <span>💰</span>
                <span class="text-gray-600">Prix</span>
                <span class="font-semibold text-gray-900">{product.indicateurs.prix}/5</span>
            </div>
            <div class="flex items-center gap-2 text-sm">
                <span>🔧</span>
                <span class="text-gray-600">Durabilité</span>
                <span class="font-semibold text-gray-900">{product.indicateurs.durabilite}/5</span>
            </div>
            <div class="flex items-center gap-2 text-sm">
                <span>✅</span>
                <span class="text-gray-600">Fiabilité</span>
                <span class="font-semibold text-gray-900">{product.indicateurs.fiabilite}/5</span>
            </div>
        </div>
        
        <!-- Note moyenne -->
        <div class="flex items-center justify-between mb-4 py-2 border-t border-b border-gray-100">
            <span class="text-sm text-gray-600">Note moyenne</span>
            <div class="flex items-center gap-1">
                <span class="text-yellow-400 text-lg">★</span>
                <span class="font-bold text-lg text-gray-900">{average.toFixed(1)}/5</span>
            </div>
        </div>
        
        <!-- Verdict -->
        <div class="bg-gray-50 rounded-lg p-3 mb-4">
            <p class="text-sm font-medium text-gray-900">💬 {product.verdict}</p>
        </div>
        
        <!-- Recommandé pour -->
        <div class="mb-4">
            <p class="text-xs text-gray-500 mb-2">✅ Recommandé pour :</p>
            <div class="flex flex-wrap gap-1">
                {product.recommandePour.map(tag => (
                    <span class="text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded-full">{tag}</span>
                ))}
            </div>
        </div>
        
        <!-- Non recommandé pour -->
        {product.nonRecommandePour.length > 0 && (
            <div class="mb-4">
                <p class="text-xs text-gray-500 mb-2">⚠️ Moins adapté pour :</p>
                <div class="flex flex-wrap gap-1">
                    {product.nonRecommandePour.map(tag => (
                        <span class="text-xs bg-orange-100 text-orange-700 px-2 py-0.5 rounded-full">{tag}</span>
                    ))}
                </div>
            </div>
        )}
        
        <!-- Prix et CTA -->
        <div class="mt-auto">
            {product.prix && (
                <p class="text-2xl font-bold text-gray-900 mb-3">{product.prix}</p>
            )}
            
            <a 
                href={product.lienAmazon}
                target="_blank"
                rel="noopener noreferrer sponsored"
                class="block w-full bg-gradient-to-r from-yellow-400 to-orange-400 hover:from-yellow-500 hover:to-orange-500 text-gray-900 font-bold py-3 px-6 rounded-xl text-center transition-all duration-300 shadow-md hover:shadow-lg"
            >
                Voir sur Amazon →
            </a>
            
            <p class="text-xs text-gray-400 text-center mt-2">
                Lien affilié Amazon
            </p>
        </div>
    </div>
</article>
