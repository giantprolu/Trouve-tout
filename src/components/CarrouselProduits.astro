---
/**
 * Carrousel de cartes en pile légèrement éventée — chaque carte se redresse
 * et se détache (pop-out) au survol/focus. Remplace le listing par marque
 * sur les pages catégorie : les produits y sont mélangés, toutes marques et
 * tous prix confondus.
 */
import type { Produit } from '../lib/data';
import { SEGMENT_LABEL } from '../lib/data';
import { fourchettePrix } from '../lib/affiliation';
import { imageTaille } from '../lib/image';
import { getMarqueBySlug } from '../lib/data';
import CTAAffilie from './CTAAffilie.astro';

interface Props {
  produits: Produit[];
}
const { produits } = Astro.props;
---
<div class="carrousel-produits -mx-1 flex gap-5 overflow-x-auto px-1 pb-6 pt-3 snap-x snap-mandatory scroll-px-1">
  {produits.map((p) => {
    const marque = getMarqueBySlug(p.marqueSlug);
    return (
      <div class="carte-produit relative flex w-[210px] flex-none flex-col gap-3 rounded-tile bg-card p-5 shadow-tile snap-start">
        <span class="self-start rounded-full bg-bg px-3 py-1 font-mono text-label uppercase text-ink/70">
          {SEGMENT_LABEL[p.segment]}
        </span>
        <a href={`/produits/${p.slug}`} class="flex flex-1 flex-col gap-3">
          {p.image && (
            <div class="flex h-28 items-center justify-center rounded bg-white p-2">
              <img src={imageTaille(p.image, 260)} width="120" height="112" alt="" loading="lazy" decoding="async" class="max-h-full max-w-full object-contain" />
            </div>
          )}
          <div class="flex-1">
            {marque && <p class="m-0 font-mono text-label uppercase text-ink/55">{marque.nom}</p>}
            <p class="m-0 mt-1 font-display font-bold text-body text-ink leading-snug hover:text-accent transition-colors">{p.nom}</p>
          </div>
          <p class="m-0 font-mono text-data font-semibold text-ink">{fourchettePrix(p.prixIndicatif)}</p>
        </a>
        <CTAAffilie url={p.urlMarchand} marchand={p.marchand} variant="small" label="Voir le produit" />
      </div>
    );
  })}
</div>

<style>
  .carrousel-produits {
    perspective: 1400px;
  }
  .carte-produit {
    transition: transform 280ms ease, box-shadow 280ms ease;
    transform: rotate(var(--tilt, 0deg)) translateY(0) scale(0.97);
  }
  .carte-produit:nth-child(3n) {
    --tilt: -2deg;
  }
  .carte-produit:nth-child(3n + 1) {
    --tilt: 1.5deg;
  }
  .carte-produit:nth-child(3n + 2) {
    --tilt: -1deg;
  }
  .carte-produit:hover,
  .carte-produit:focus-within {
    transform: rotate(0deg) translateY(-10px) scale(1.04);
    box-shadow: 0 22px 40px -18px rgb(28 30 26 / 0.4);
    z-index: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .carte-produit {
      transform: none;
      transition: none;
    }
  }
</style>
