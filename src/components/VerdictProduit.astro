---
import type { Produit } from '../lib/data';
import { niveauConfiance } from '../lib/data';
import CTAAffilie from './CTAAffilie.astro';
import EncartTransparence from './EncartTransparence.astro';
import Cote from './Cote.astro';
import TrancheBudget from './TrancheBudget.astro';

interface Props {
  produit: Produit;
  numero?: number;
}
const { produit, numero } = Astro.props;
const score = Math.round(niveauConfiance(produit) * 10);
---
<div class="coin-coupe bg-surface border border-line px-6 py-6">
  {numero && (
    <p class="font-mono text-label uppercase text-ink mb-3">N°{numero}</p>
  )}

  <p class="font-mono text-label uppercase text-ink mb-1">Pour qui ?</p>
  <h2 class="font-display text-display-m text-ink mb-2">{produit.verdict}</h2>
  <p class="font-body text-body text-ink mb-5">{produit.description}</p>

  <div class="mb-6">
    <Cote valeur={score} max={10} label={`${score}/10`} />
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
    <div>
      <p class="font-mono text-label uppercase text-ink mb-1">Ce qui compte</p>
      <p class="font-body text-body text-ink">{produit.pourQui}</p>
    </div>
    <div>
      <p class="font-mono text-label uppercase text-ink mb-1">Ce qui ne compte pas</p>
      <p class="font-body text-body text-ink">{produit.contreQui}</p>
    </div>
  </div>

  <div class="mb-6">
    <TrancheBudget prixIndicatif={produit.prixIndicatif} />
  </div>

  <div class="space-y-3">
    <CTAAffilie url={produit.urlMarchand} marchand={produit.marchand} />
    <EncartTransparence />
  </div>
</div>
