---
import type { Produit } from '../lib/data';
import { niveauConfiance } from '../lib/data';
import { imageTaille } from '../lib/image';
import CTAAffilie from './CTAAffilie.astro';
import EncartTransparence from './EncartTransparence.astro';
import Cote from './Cote.astro';
import TrancheBudget from './TrancheBudget.astro';

interface Props {
  produit: Produit;
  numero?: number;
  horizontal?: boolean;
}
const { produit, numero, horizontal = false } = Astro.props;
const score = Math.round(niveauConfiance(produit) * 10);
---
<div class={`coin-coupe bg-surface border border-line px-6 py-6 ${horizontal ? 'flex flex-wrap items-start gap-6' : ''}`}>
  {numero && (
    <p class={`font-mono text-label uppercase text-ink ${horizontal ? 'w-full' : 'mb-3'}`}>N°{numero}</p>
  )}

  {produit.image && (
    <div class={`rounded bg-white flex items-center justify-center ${horizontal ? 'h-32 w-32 flex-none' : 'mb-4 h-32'}`}>
      <img src={imageTaille(produit.image, 260)} width="128" height="128" alt={produit.nom} class="max-h-full max-w-full object-contain" loading="lazy" decoding="async" />
    </div>
  )}

  <div class={horizontal ? 'flex-1 min-w-[220px]' : ''}>
    <p class="font-mono text-label uppercase text-ink mb-1">Pour qui ?</p>
    <h2 class="font-display text-display-m text-ink mb-2">{produit.verdict}</h2>
    <p class={`font-body text-body text-ink ${horizontal ? '' : 'mb-5'}`}>{produit.description}</p>
  </div>

  <div class={horizontal ? 'flex-none' : 'mb-6'}>
    <Cote valeur={score} max={10} label={`${score}/10`} />
  </div>

  <div class={horizontal ? 'flex flex-wrap gap-6' : 'grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6'}>
    <div class={horizontal ? 'flex-1 min-w-[180px]' : ''}>
      <p class="font-mono text-label uppercase text-ink mb-1">Ce qui compte</p>
      <p class="font-body text-body text-ink">{produit.pourQui}</p>
    </div>
    <div class={horizontal ? 'flex-1 min-w-[180px]' : ''}>
      <p class="font-mono text-label uppercase text-ink mb-1">Ce qui ne compte pas</p>
      <p class="font-body text-body text-ink">{produit.contreQui}</p>
    </div>
  </div>

  <div class={horizontal ? 'flex-none' : 'mb-6'}>
    <TrancheBudget produit={produit} />
  </div>

  <div class={`space-y-3 ${horizontal ? 'flex-1 min-w-[200px]' : ''}`}>
    <CTAAffilie url={produit.urlMarchand} marchand={produit.marchand} />
    <EncartTransparence />
  </div>
</div>
