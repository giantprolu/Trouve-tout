---
import type { Produit } from '../lib/data';
import { niveauConfiance } from '../lib/data';
import CTAAffilie from './CTAAffilie.astro';
import EncartTransparence from './EncartTransparence.astro';
import NiveauABulle from './NiveauABulle.astro';
import TrancheBudget from './TrancheBudget.astro';

interface Props {
  produit: Produit;
  numero?: number;
}
const { produit, numero } = Astro.props;
---
<div class="bg-tole border-t-[3px] border-cordeau px-6 py-6">
  {numero && (
    <p class="font-mono text-kicker uppercase text-graphite mb-3">N°{numero}</p>
  )}

  <NiveauABulle niveau={niveauConfiance(produit)} taille="grand" class="mb-4" />

  <h2 class="font-display text-display-m text-graphite mb-2">{produit.verdict}</h2>
  <p class="font-lecture text-lecture text-graphite mb-5">{produit.description}</p>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
    <div>
      <p class="font-mono text-kicker uppercase text-graphite mb-1">Ce qui compte</p>
      <p class="font-lecture text-lecture text-graphite">{produit.pourQui}</p>
    </div>
    <div>
      <p class="font-mono text-kicker uppercase text-graphite mb-1">Ce qui ne compte pas</p>
      <p class="font-lecture text-lecture text-graphite">{produit.contreQui}</p>
    </div>
  </div>

  <div class="mb-6">
    <TrancheBudget prixIndicatif={produit.prixIndicatif} />
  </div>

  <div class="space-y-3">
    <CTAAffilie url={produit.urlMarchand} marchand={produit.marchand} />
    <EncartTransparence />
  </div>
</div>
