---
import { segmentBudget, BORNES_BUDGET } from '../lib/affiliation';
import Cote from './Cote.astro';

/**
 * Bandeau de budget gradué — design-system.md §6.
 * Affiche une TRANCHE, jamais le prix exact (non-négociable) : le montant
 * indicatif ne sert qu'à calculer quel segment mettre en évidence.
 */
interface Props {
  prixIndicatif: number;
}
const { prixIndicatif } = Astro.props;
const { index, total, label } = segmentBudget(prixIndicatif);
const segmentPct = 100 / total;
const centrePct = segmentPct * index + segmentPct / 2;
const debutPct = segmentPct * index;
---
<div class="w-full">
  <div class="relative" role="img" aria-label={`Tranche de budget : ${label}`}>
    <div
      class="absolute bottom-0 h-1.5 bg-accent rounded-sm pointer-events-none"
      style={`left: ${debutPct}%; width: ${segmentPct}%; transform: translateY(50%)`}
    ></div>
    <Cote valeur={centrePct} max={100} label={label} />
  </div>

  <div class="flex justify-between font-mono text-data text-ink">
    <span>{BORNES_BUDGET[0]} €</span>
    <span>{BORNES_BUDGET[BORNES_BUDGET.length - 1]} €</span>
  </div>

  <p class="mt-2 text-small text-ink">Repère indicatif — le prix exact est affiché chez le marchand.</p>
</div>
