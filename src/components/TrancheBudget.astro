---
import { segmentBudget, BORNES_BUDGET, prixActuel, prixAffichage } from '../lib/affiliation';
import type { Produit } from '../lib/data';
import Cote from './Cote.astro';

/**
 * Bandeau de prix gradué — design-system.md §6.
 * Affiche le prix exact quand une synchronisation Awin fraîche existe, sinon
 * une fourchette de 50 € max autour du prix constaté (voir CLAUDE.md section
 * "Prix") ; la jauge garde son utilite visuelle pour situer ce prix parmi
 * les autres produits de la selection.
 */
interface Props {
  produit: Pick<Produit, 'slug' | 'prixIndicatif'>;
}
const { produit } = Astro.props;
const { valeur, exact } = prixActuel(produit);
const { index, total } = segmentBudget(valeur);
const prixFormate = prixAffichage(produit);
const segmentPct = 100 / total;
const centrePct = segmentPct * index + segmentPct / 2;
const debutPct = segmentPct * index;
---
<div class="w-full">
  <div class="relative" role="img" aria-label={`Prix : ${prixFormate}`}>
    <div
      class="absolute bottom-0 h-1.5 bg-accent rounded-sm pointer-events-none"
      style={`left: ${debutPct}%; width: ${segmentPct}%; transform: translateY(50%)`}
    ></div>
    <Cote valeur={centrePct} max={100} label={prixFormate} />
  </div>

  <div class="flex justify-between font-mono text-data text-ink">
    <span>{BORNES_BUDGET[0]} €</span>
    <span>{BORNES_BUDGET[BORNES_BUDGET.length - 1]} €</span>
  </div>

  <p class="mt-2 text-small text-ink">
    {exact
      ? 'Prix constaté chez le marchand, synchronisé automatiquement.'
      : 'Fourchette basée sur le prix constaté chez le marchand au moment de la rédaction — le prix exact peut avoir changé depuis.'}
  </p>
</div>
