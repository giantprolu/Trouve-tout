---
interface Props {
  verdict: string;
  forWhom: string;
  notForWhom: string;
  isTopPick?: boolean;
}

const { verdict, forWhom, notForWhom, isTopPick = false } = Astro.props;
---

<div class={`my-4 p-4 bg-white border rounded-lg shadow-sm ${isTopPick ? 'border-green-300 bg-green-50' : ''}`}>
  <div class="flex items-center gap-2 mb-3">
    {isTopPick && (
      <span class="text-lg">🏆</span>
    )}
    <span class={`inline-block px-3 py-1 rounded text-xs font-bold ${isTopPick ? 'bg-green-200 text-green-900' : 'bg-green-100 text-green-800'}`}>
      {verdict}
    </span>
  </div>
  
  <div class="space-y-2 text-sm">
    <div class="flex flex-col sm:flex-row sm:gap-2">
      <span class="font-medium text-gray-700 min-w-[120px]">✅ Pour qui :</span>
      <span class="text-gray-800">{forWhom}</span>
    </div>
    <div class="flex flex-col sm:flex-row sm:gap-2">
      <span class="font-medium text-gray-700 min-w-[120px]">❌ Ne convient pas à :</span>
      <span class="text-gray-800">{notForWhom}</span>
    </div>
  </div>
</div>
